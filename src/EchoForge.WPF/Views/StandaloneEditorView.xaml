<UserControl x:Class="EchoForge.WPF.Views.StandaloneEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:EchoForge.WPF.Converters"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="#0B0E14" Foreground="#F8FAFC">

    <UserControl.Resources>
        <converters:StringMatchToVisibilityConverter x:Key="StringMatchVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:PositionToPixelsMultiConverter x:Key="PositionToPixelsMultiConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>  <!-- Header -->
            <RowDefinition Height="*"/>   <!-- Main Layout -->
            <RowDefinition Height="Auto"/> <!-- Divider -->
            <RowDefinition Height="220"/> <!-- Timeline -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ROW ═══ -->
        <Border Grid.Row="0" BorderBrush="#1A1F2B" BorderThickness="0,0,0,1" Padding="20,0" Panel.ZIndex="100">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#12161F" Offset="0"/>
                    <GradientStop Color="#0D1117" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" Content="← Panele Dön" Style="{StaticResource SecondaryButton}" 
                        Command="{Binding GoBackCommand}" Padding="12,6" VerticalAlignment="Center" Margin="0,0,20,0"/>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✏ Video Düzenleyici" FontSize="16" FontWeight="Bold" Foreground="#A855F7" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding ProjectTitle, StringFormat='— {0}', FallbackValue='— Untitled Video'}" FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Regenerate Scene Button -->
                    <Button Content="🔄 AI Görseli Yenile" 
                            Command="{Binding RegenerateSceneCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTip="Seçili sahnenin görselini yeniden oluştur" Foreground="#60A5FA"/>

                    <!-- Approve Project Button -->
                    <Button Content="✅ Projeyi Onayla" 
                            Command="{Binding ApproveProjectCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTip="Projeyi Yayın İçin Onaylar" Foreground="#10B981"/>

                    <!-- YouTube Channel Selector -->
                    <ComboBox ItemsSource="{Binding YouTubeChannels}"
                              SelectedItem="{Binding SelectedYouTubeChannel}"
                              DisplayMemberPath="ChannelName"
                              Style="{StaticResource DarkComboBox}"
                              Width="200" Height="34" Margin="0,0,8,0"
                              ToolTip="Hedef YouTube Kanalı"/>

                    <!-- YouTube Push Button -->
                    <Button Content="▶️ YouTube'a Yükle" 
                            Command="{Binding UploadToYouTubeCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTip="Oluşturulan videoyu YouTube kanalınıza yayınlar" Foreground="#EF4444"/>

                    <!-- Export Settings Button -->
                    <Button Content="⚙" Command="{Binding ToggleExportPanelCommand}" 
                            Style="{StaticResource SecondaryButton}" Padding="8,6" Margin="0,0,4,0" FontSize="14" ToolTip="Export Settings"/>
                    <!-- Export Button -->
                    <Button Content="🎬 Videoyu Oluştur" 
                            Command="{Binding RenderVideoCommand}"
                            Padding="16,8" FontSize="14" FontWeight="Bold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#10B981" Offset="0"/>
                                            <GradientStop Color="#059669" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Floating Export Options Dropdown Panel (Overlay) -->
        <Border Grid.RowSpan="4" Background="#1A1F2E" CornerRadius="10" Padding="16,14" Margin="0,56,24,0"
                BorderBrush="#2D3548" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Right"
                Panel.ZIndex="999">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExportPanelOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Width="220">
                <TextBlock Text="📦 Export Settings" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,12"/>
                
                <!-- Resolution -->
                <TextBlock Text="Resolution" Foreground="#64748B" FontSize="10" Margin="0,0,0,4"/>
                <ComboBox SelectedItem="{Binding ExportResolution}" Style="{StaticResource ModernComboBox}" Margin="0,0,0,10">
                    <ComboBoxItem Content="1280x720"/>
                    <ComboBoxItem Content="1920x1080"/>
                    <ComboBoxItem Content="2560x1440"/>
                    <ComboBoxItem Content="3840x2160"/>
                </ComboBox>
                
                <!-- FPS -->
                <TextBlock Text="Frame Rate" Foreground="#64748B" FontSize="10" Margin="0,0,0,4"/>
                <ComboBox SelectedItem="{Binding ExportFps}" Style="{StaticResource ModernComboBox}" Margin="0,0,0,10">
                    <ComboBoxItem Content="24"/>
                    <ComboBoxItem Content="30"/>
                    <ComboBoxItem Content="60"/>
                </ComboBox>
                
                <!-- Codec -->
                <TextBlock Text="Codec" Foreground="#64748B" FontSize="10" Margin="0,0,0,4"/>
                <ComboBox SelectedItem="{Binding ExportCodec}" Style="{StaticResource ModernComboBox}" Margin="0,0,0,10">
                    <ComboBoxItem Content="H.264"/>
                    <ComboBoxItem Content="H.265"/>
                    <ComboBoxItem Content="VP9"/>
                </ComboBox>
                
                <!-- Format -->
                <TextBlock Text="Format" Foreground="#64748B" FontSize="10" Margin="0,0,0,4"/>
                <ComboBox SelectedItem="{Binding ExportFormat}" Style="{StaticResource ModernComboBox}" Margin="0,0,0,10">
                    <ComboBoxItem Content="mp4"/>
                    <ComboBoxItem Content="mkv"/>
                    <ComboBoxItem Content="webm"/>
                </ComboBox>

                <!-- Social Media Presets -->
                <TextBlock Text="🎯 Presets" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,4,0,8"/>
                <Button Content="▶ YouTube Shorts (1080x1920)" Command="{Binding ApplyExportPresetCommand}" CommandParameter="youtube_shorts" 
                        Style="{StaticResource SecondaryButton}" Padding="8,6" Margin="0,0,0,4" FontSize="10"/>
                <Button Content="📸 Instagram Reels (1080x1920)" Command="{Binding ApplyExportPresetCommand}" CommandParameter="instagram_reels" 
                        Style="{StaticResource SecondaryButton}" Padding="8,6" Margin="0,0,0,4" FontSize="10"/>
                <Button Content="🎵 TikTok (1080x1920)" Command="{Binding ApplyExportPresetCommand}" CommandParameter="tiktok" 
                        Style="{StaticResource SecondaryButton}" Padding="8,6" Margin="0,0,0,4" FontSize="10"/>
                <Button Content="🖥️ YouTube (1920x1080)" Command="{Binding ApplyExportPresetCommand}" CommandParameter="youtube" 
                        Style="{StaticResource SecondaryButton}" Padding="8,6" Margin="0,0,0,0" FontSize="10"/>
            </StackPanel>
        </Border>

        <!-- ═══ TOP ROW: 4-Column Layout ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ══ COL 0: Primary Navigation Ribbon (64px) ══ -->
            <Border Grid.Column="0" Background="#080A0F" BorderBrush="#1A1F2B" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,16,0,0">
                    <!-- Media -->
                    <Button Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="Media"
                            Background="Transparent" BorderThickness="0" Padding="0,12" Cursor="Hand" Margin="0,0,0,8" ToolTip="Media">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📁" FontSize="18" HorizontalAlignment="Center" Foreground="#94A3B8"/>
                            <TextBlock Text="Media" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssetLibraryMode}" Value="Media">
                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <!-- Record -->
                    <Button Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="Record"
                            Background="Transparent" BorderThickness="0" Padding="0,12" Cursor="Hand" Margin="0,0,0,8" ToolTip="Record">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔴" FontSize="18" HorizontalAlignment="Center" Foreground="#94A3B8"/>
                            <TextBlock Text="Record" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssetLibraryMode}" Value="Record">
                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <!-- Library -->
                    <Button Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="Library"
                            Background="Transparent" BorderThickness="0" Padding="0,12" Cursor="Hand" Margin="0,0,0,8" ToolTip="Library">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📚" FontSize="18" HorizontalAlignment="Center" Foreground="#94A3B8"/>
                            <TextBlock Text="Library" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssetLibraryMode}" Value="Library">
                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <!-- Music -->
                    <Button Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="Music"
                            Background="Transparent" BorderThickness="0" Padding="0,12" Cursor="Hand" Margin="0,0,0,8" ToolTip="Music">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🎵" FontSize="18" HorizontalAlignment="Center" Foreground="#94A3B8"/>
                            <TextBlock Text="Music" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssetLibraryMode}" Value="Music">
                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <!-- Text -->
                    <Button Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="Text"
                            Background="Transparent" BorderThickness="0" Padding="0,12" Cursor="Hand" Margin="0,0,0,8" ToolTip="Text">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="T" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#94A3B8"/>
                            <TextBlock Text="Text" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssetLibraryMode}" Value="Text">
                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <!-- Transitions -->
                    <Button Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="Transitions"
                            Background="Transparent" BorderThickness="0" Padding="0,12" Cursor="Hand" Margin="0,0,0,8" ToolTip="Transitions">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✨" FontSize="18" HorizontalAlignment="Center" Foreground="#94A3B8"/>
                            <TextBlock Text="Trans" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssetLibraryMode}" Value="Transitions">
                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <!-- Templates -->
                    <Button Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="Templates"
                            Background="Transparent" BorderThickness="0" Padding="0,12" Cursor="Hand" Margin="0,0,0,8" ToolTip="Templates">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📝" FontSize="18" HorizontalAlignment="Center" Foreground="#94A3B8"/>
                            <TextBlock Text="Şablon" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssetLibraryMode}" Value="Templates">
                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <!-- Brand Kit -->
                    <Button Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="BrandKit"
                            Background="Transparent" BorderThickness="0" Padding="0,12" Cursor="Hand" Margin="0,0,0,8" ToolTip="Brand Kit">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⭐" FontSize="18" HorizontalAlignment="Center" Foreground="#94A3B8"/>
                            <TextBlock Text="Marka" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssetLibraryMode}" Value="BrandKit">
                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ══ COL 1: Asset Library Panel (expandable 300px) ══ -->
            <Border Grid.Column="1" Width="300" Background="#0C1017" BorderBrush="#1A1F2B" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsAssetLibraryOpen, Converter={StaticResource BoolToVis}}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding AssetLibraryMode}" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" DockPanel.Dock="Left"/>
                        <Button Content="✕" Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="{Binding AssetLibraryMode}"
                                DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="6,4"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Media Tab -->
                            <StackPanel Visibility="{Binding AssetLibraryMode, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter='Media'}">
                                <Button Content="➕ Import Media" Command="{Binding ImportMediaCommand}" Style="{StaticResource PrimaryButton}" Padding="12,10" Margin="0,0,0,12"/>
                                <Border BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="8" Padding="16" Background="#0A3B82F6" Margin="0,0,0,12"
                                        AllowDrop="True" Drop="Border_Drop">
                                    <TextBlock Text="Drag and drop files here" Foreground="#94A3B8" TextAlignment="Center"/>
                                </Border>
                                
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Your Media" Foreground="#F8FAFC" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <ComboBox SelectedItem="{Binding MediaFilter}" Width="80" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <ComboBoxItem Content="All"/>
                                        <ComboBoxItem Content="Video"/>
                                        <ComboBoxItem Content="Audio"/>
                                        <ComboBoxItem Content="Image"/>
                                    </ComboBox>
                                </DockPanel>

                                <!-- Imported media list -->
                                <ItemsControl ItemsSource="{Binding ImportedMedia}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A1E293B" CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Thumbnail Placeholder -->
                                                    <Border Grid.Column="0" Width="40" Height="24" Background="#0D1117" CornerRadius="4" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Icon}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    
                                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#E2E8F0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Record Tab -->
                            <StackPanel Visibility="{Binding AssetLibraryMode, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter='Record'}">
                                <TextBlock Text="Create recordings directly." Foreground="#94A3B8" Margin="0,0,0,16" TextWrapping="Wrap"/>
                                <Button Content="📹 Screen &amp; Camera" Command="{Binding RecordScreenAndCameraCommand}" Style="{StaticResource PrimaryButton}" Padding="12,10" Margin="0,0,0,8" Background="#EAB308" Foreground="#1F2937"/>
                                <Button Content="📸 Camera Only" Command="{Binding RecordCameraCommand}" Style="{StaticResource SecondaryButton}" Padding="12,10" Margin="0,0,0,8"/>
                                <Button Content="🎤 Audio Only" Command="{Binding RecordAudioCommand}" Style="{StaticResource SecondaryButton}" Padding="12,10" Margin="0,0,0,8"/>
                                <Button Content="🗣️ Text-to-Speech" Command="{Binding TextToSpeechCommand}" Style="{StaticResource SecondaryButton}" Padding="12,10" Margin="0,0,0,8"/>
                            </StackPanel>

                            <!-- Library Tab -->
                            <StackPanel Visibility="{Binding AssetLibraryMode, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter='Library'}">
                                <TextBlock Text="Browse stock content." Foreground="#94A3B8" Margin="0,0,0,12"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" Tag="Search library..."/>
                                
                                <TextBlock Text="Categories" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2">
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,6,6" Padding="8" MinHeight="50" Cursor="Hand">
                                        <TextBlock Text="🎞️ Stock Video" Foreground="#F8FAFC" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,6" Padding="8" MinHeight="50" Cursor="Hand">
                                        <TextBlock Text="🖼️ Stock Image" Foreground="#F8FAFC" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,6,6" Padding="8" MinHeight="50" Cursor="Hand">
                                        <TextBlock Text="🌈 Backgrounds" Foreground="#F8FAFC" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,6" Padding="8" MinHeight="50" Cursor="Hand">
                                        <TextBlock Text="🙂 Stickers" Foreground="#F8FAFC" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,6,6" Padding="8" MinHeight="50" Cursor="Hand">
                                        <TextBlock Text="💫 GIPHY" Foreground="#F8FAFC" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,6" Padding="8" MinHeight="50" Cursor="Hand">
                                        <TextBlock Text="✨ Overlays" Foreground="#F8FAFC" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>

                            <!-- Music Tab -->
                            <StackPanel Visibility="{Binding AssetLibraryMode, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter='Music'}">
                                <TextBlock Text="Background music &amp; SFX." Foreground="#94A3B8" Margin="0,0,0,12"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" Tag="Search audio..."/>
                                
                                <UniformGrid Columns="2">
                                    <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="8" Margin="0,0,6,6" Padding="8" MinHeight="50" Cursor="Hand">
                                        <TextBlock Text="🎵 Free Music" Foreground="#10B981" FontWeight="Bold" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="#1A8B5CF6" BorderBrush="#338B5CF6" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6" Padding="8" MinHeight="50" Cursor="Hand">
                                        <TextBlock Text="🔊 Sound Effects" Foreground="#8B5CF6" FontWeight="Bold" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>

                            <!-- Text Tab -->
                            <StackPanel Visibility="{Binding AssetLibraryMode, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter='Text'}">
                                <TextBlock Text="Add text overlays." Foreground="#94A3B8" Margin="0,0,0,12"/>
                                <Button Content="T Add Plain Text" Command="{Binding ApplyTextStyleCommand}" CommandParameter="plain" Style="{StaticResource SecondaryButton}" Padding="12,10" Margin="0,0,0,12" FontWeight="Bold"/>
                                
                                <TextBlock Text="Premium Styles" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="8" MinHeight="45" Cursor="Hand" Tag="ai_captions" MouseLeftButtonDown="TextStyleCard_MouseLeftButtonDown">
                                        <TextBlock Text="AI Captions" Foreground="#60A5FA" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,4" Padding="8" MinHeight="45" Cursor="Hand" Tag="glitch" MouseLeftButtonDown="TextStyleCard_MouseLeftButtonDown">
                                        <TextBlock Text="Glitch" Foreground="#10B981" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="8" MinHeight="45" Cursor="Hand" Tag="neon" MouseLeftButtonDown="TextStyleCard_MouseLeftButtonDown">
                                        <TextBlock Text="Neon" Foreground="#EC4899" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,4" Padding="8" MinHeight="45" Cursor="Hand" Tag="groovy" MouseLeftButtonDown="TextStyleCard_MouseLeftButtonDown">
                                        <TextBlock Text="Groovy" Foreground="#F59E0B" FontWeight="Bold" FontStyle="Italic" TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="8" MinHeight="45" Cursor="Hand" Tag="funky" MouseLeftButtonDown="TextStyleCard_MouseLeftButtonDown">
                                        <TextBlock Text="Funky" Foreground="#8B5CF6" FontWeight="Black" TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                    </Border>
