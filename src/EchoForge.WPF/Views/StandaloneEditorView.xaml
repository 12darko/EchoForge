                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="cross blur" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Cross Blur" Foreground="#3B82F6" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="fade" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Fade Black" Foreground="#64748B" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="fade white" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Fade White" Foreground="#F8FAFC" FontWeight="Bold" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                </UniformGrid>

                                <!-- Wipes -->
                                <TextBlock Text="Wipes" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,8" FontSize="11"/>
                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="wipe left" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Wipe Left" Foreground="#F8FAFC" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="wipe right" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Wipe Right" Foreground="#F8FAFC" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="wipe up" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Wipe Up" Foreground="#F8FAFC" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="wipe down" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Wipe Down" Foreground="#F8FAFC" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="soft wipe" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Soft Wipe" Foreground="#94A3B8" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="diagonal" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Diagonal" Foreground="#F8FAFC" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                </UniformGrid>

                                <!-- Geometric -->
                                <TextBlock Text="Geometric" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,8" FontSize="11"/>
                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="blinds" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Blinds" Foreground="#F8FAFC" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="tiles" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Tiles" Foreground="#F8FAFC" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="pixelize" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Pixelate" Foreground="#34D399" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="diamond_h" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Diamond H" Foreground="#F8FAFC" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="diamond_v" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Diamond V" Foreground="#F8FAFC" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                </UniformGrid>

                                <!-- Dynamic -->
                                <TextBlock Text="Dynamic" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,8" FontSize="11"/>
                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="zoom in" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Zoom In" Foreground="#F8FAFC" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="zoom out" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Zoom Out" Foreground="#F8FAFC" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="spin" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Spin" Foreground="#FBBF24" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="zoom spin" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Zoom Spin" Foreground="#F59E0B" FontWeight="Bold" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="swirl" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Swirl" Foreground="#14B8A6" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                </UniformGrid>

                                <!-- Creative -->
                                <TextBlock Text="Creative" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,8" FontSize="11"/>
                                <UniformGrid Columns="3" Margin="0,0,0,4">
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="glitch" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Glitch" Foreground="#10B981" FontWeight="Bold" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="bloom" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Bloom" Foreground="#FDE047" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="burn" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Burn" Foreground="#EF4444" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="exchange" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Exchange" Foreground="#3B82F6" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="page turn" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Page Turn" Foreground="#CBD5E1" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="reveal" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Reveal" Foreground="#3B82F6" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,4,4" Padding="6" MinHeight="45" Cursor="Hand" Tag="cube 3d" MouseLeftButtonDown="TransitionCard_MouseLeftButtonDown"><TextBlock Text="Cube 3D" Foreground="#8B5CF6" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/></Border>
                                </UniformGrid>
                            </StackPanel>

                            <!-- Templates Tab -->
                            <StackPanel Visibility="{Binding AssetLibraryMode, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter='Templates'}">
                                <TextBlock Text="Start from a template." Foreground="#94A3B8" Margin="0,0,0,12"/>
                                
                                <TextBlock Text="Platform" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2">
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,6,6" Padding="8" MinHeight="40" Cursor="Hand">
                                        <TextBlock Text="▶️ YouTube 16:9" Foreground="#EF4444" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,6" Padding="8" MinHeight="40" Cursor="Hand">
                                        <TextBlock Text="📱 TikTok 9:16" Foreground="#F8FAFC" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,6,6" Padding="8" MinHeight="40" Cursor="Hand">
                                        <TextBlock Text="📸 Insta 1:1" Foreground="#EC4899" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,6" Padding="8" MinHeight="40" Cursor="Hand">
                                        <TextBlock Text="💼 LinkedIn" Foreground="#3B82F6" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </UniformGrid>
                                
                                <TextBlock Text="Themes" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,12,0,8"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#1A3B82F6" CornerRadius="8" Width="100" Height="60" Margin="0,0,8,0" Cursor="Hand">
                                            <TextBlock Text="🎉 Birthday" Foreground="#60A5FA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#1A10B981" CornerRadius="8" Width="100" Height="60" Margin="0,0,8,0" Cursor="Hand">
                                            <TextBlock Text="🎓 Education" Foreground="#34D399" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#1A8B5CF6" CornerRadius="8" Width="100" Height="60" Margin="0,0,8,0" Cursor="Hand">
                                            <TextBlock Text="🎮 Gaming" Foreground="#A78BFA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- Brand Kit Tab -->
                            <StackPanel Visibility="{Binding AssetLibraryMode, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter='BrandKit'}">
                                <TextBlock Text="Premium Brand Kit" Foreground="#F59E0B" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="Manage your cohesive brand." Foreground="#94A3B8" Margin="0,0,0,16" TextWrapping="Wrap"/>
                                
                                <TextBlock Text="Logos" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Border Background="#1A1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#333B82F6" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="⁺" FontSize="20" HorizontalAlignment="Center" Foreground="#3B82F6" Margin="0,0,0,4"/>
                                        <TextBlock Text="Add Logo" FontSize="11" HorizontalAlignment="Center" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                                
                                <TextBlock Text="Fonts" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Border Background="#1A1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#333B82F6" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="T⁺" FontSize="16" HorizontalAlignment="Center" Foreground="#3B82F6" Margin="0,0,0,4"/>
                                        <TextBlock Text="Upload Custom Font" FontSize="11" HorizontalAlignment="Center" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Colors" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="30" Height="30" Background="#EF4444" CornerRadius="4" Margin="0,0,8,0"/>
                                    <Border Width="30" Height="30" Background="#F59E0B" CornerRadius="4" Margin="0,0,8,0"/>
                                    <Border Width="30" Height="30" Background="#10B981" CornerRadius="4" Margin="0,0,8,0"/>
                                    <Border Width="30" Height="30" Background="#3B82F6" CornerRadius="4" Margin="0,0,8,0"/>
                                    <Border Width="30" Height="30" Background="#1A1E293B" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="4">
                                        <TextBlock Text="+" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                
                                <Button Content="👑 Upgrade to Premium" Style="{StaticResource PrimaryButton}" Background="#F59E0B" Foreground="#1F2937" Padding="12,10" Margin="0,8,0,0"/>
                            </StackPanel>


                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══ COL 2: Video Preview ══ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Grid.Column" Value="2"/>
                        <Setter Property="Margin" Value="8,8,4,8"/>
                        <Setter Property="Panel.ZIndex" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullscreenPreview}" Value="True">
                                <Setter Property="Grid.Column" Value="0"/>
                                <Setter Property="Grid.ColumnSpan" Value="4"/>
                                <Setter Property="Grid.Row" Value="1"/>
                                <Setter Property="Grid.RowSpan" Value="4"/>
                                <Setter Property="Margin" Value="10,10,10,20"/>
                                <Setter Property="Panel.ZIndex" Value="9999"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0D1117" CornerRadius="12" ClipToBounds="True">
                    <Grid>
                        <!-- Scene Preview Image (from project scenes) -->
                        <Border Background="#161B22" CornerRadius="12">
                            <Grid>
                                <!-- Video Preview Area Container -->
                                <Border Grid.Row="0" Margin="16" Background="#0C0F17" CornerRadius="8" BorderBrush="#1A1F2B" BorderThickness="1" ClipToBounds="True">
                                    <Grid x:Name="VideoPreviewGrid">
                                        
                                        <!-- VLC Video View -->
                                        <vlc:VideoView x:Name="VideoPlayer" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="1">
                                            <vlc:VideoView.Style>
                                                <Style TargetType="vlc:VideoView">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasVideo}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </vlc:VideoView.Style>
                                        </vlc:VideoView>

                                        <!-- No selection placeholder -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="2">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasVideo}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="🎬" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                            <TextBlock Text="Video Düzenleyici" Foreground="#E2E8F0" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                            <Button Content="📁 Video Aç" Command="{Binding OpenVideoCommand}" Style="{StaticResource PrimaryButton}" Padding="24,12" FontSize="14"/>
                                        </StackPanel>

                                        <!-- Image/Video Preview -->
                                        <Image Source="{Binding PreviewImagePath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0"
                                               Opacity="{Binding PreviewOpacity, FallbackValue=1.0}" Panel.ZIndex="3"/>

                                                <ItemsControl ItemsSource="{Binding SelectedScene.TextOverlays}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Grid Background="{x:Null}" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Text, TargetNullValue='', FallbackValue=''}" 
                                                                       FontSize="{Binding FontSize, FallbackValue=48}"
                                                                       Foreground="{Binding Color, FallbackValue='#FFFFFF'}"
                                                                       FontFamily="{Binding FontFamily, FallbackValue='Inter'}"
                                                                       Opacity="1.0"
                                                                       FontWeight="Bold" TextWrapping="Wrap" MaxWidth="800" TextAlignment="Center"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Cursor="SizeAll"
                                                                       MouseLeftButtonDown="TextOverlay_MouseLeftButtonDown"
                                                                       MouseMove="TextOverlay_MouseMove"
                                                                       MouseLeftButtonUp="TextOverlay_MouseLeftButtonUp">
                                                                <TextBlock.RenderTransform>
                                                                    <TranslateTransform>
                                                                        <TranslateTransform.X>
                                                                            <MultiBinding Converter="{StaticResource PositionToPixelsMultiConverter}">
                                                                                <Binding Path="PositionX" />
                                                                                <Binding Path="ActualWidth" ElementName="VideoPreviewGrid" />
                                                                            </MultiBinding>
                                                                        </TranslateTransform.X>
                                                                        <TranslateTransform.Y>
                                                                            <MultiBinding Converter="{StaticResource PositionToPixelsMultiConverter}">
                                                                                <Binding Path="PositionY" />
                                                                                <Binding Path="ActualHeight" ElementName="VideoPreviewGrid" />
                                                                            </MultiBinding>
                                                                        </TranslateTransform.Y>
                                                                    </TranslateTransform>
                                                                </TextBlock.RenderTransform>
                                                                <TextBlock.Effect>
                                                                    <DropShadowEffect Color="Black" BlurRadius="{Binding ShadowOpacity}" Direction="315" ShadowDepth="2" Opacity="{Binding ShadowOpacity}"/>
                                                                </TextBlock.Effect>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Active Scene info overlay -->
                        <Border Background="#E60B0E14" CornerRadius="0,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="14,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedScene.SceneNumber, StringFormat='Scene {0}', FallbackValue='Scene'}" FontSize="14" FontWeight="Bold" Foreground="#A855F7"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- PLAYBACK CONTROLS -->
                <Border Grid.Row="1" Background="#12161F" CornerRadius="8" Margin="0,8,0,0" Padding="12,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="↩️" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" Style="{StaticResource SecondaryButton}" Width="36" Height="36" FontSize="16" Margin="0,0,12,0" Padding="0"/>
                            <Button Content="⏮" Command="{Binding SeekToStartCommand}" ToolTip="Start" Style="{StaticResource SecondaryButton}" Width="36" Height="36" FontSize="14" Margin="0,0,6,0" Padding="0"/>
                            <!-- Play/Pause -->
                            <Button Command="{Binding TogglePlaybackCommand}" Width="46" Height="46" FontSize="18" Margin="0,0,6,0" Padding="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="▶"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Content" Value="⏸"/>
                                                <Setter Property="Background" Value="#F59E0B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="⏭" Command="{Binding SeekToEndCommand}" ToolTip="End" Style="{StaticResource SecondaryButton}" Width="36" Height="36" FontSize="14" Margin="0,0,6,0" Padding="0"/>
                            <Button Content="↪️" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" Style="{StaticResource SecondaryButton}" Width="36" Height="36" FontSize="16" Margin="0,0,12,0" Padding="0"/>
                            <Button Content="⛶" Command="{Binding ToggleFullscreenPreviewCommand}" ToolTip="Fullscreen Preview (F)" Style="{StaticResource SecondaryButton}" Width="36" Height="36" FontSize="16" Padding="0"/>
                        </StackPanel>
                        <!-- Time Display BELOW buttons -->
                        <TextBlock Grid.Row="1" Text="{Binding CurrentPlaybackTimeDisplay}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ COL 3: Properties Panel ══ -->
            <Border Grid.Column="3" Background="#12161F" Margin="4,8,8,8" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Properties Header -->
                    <Border Grid.Row="0" CornerRadius="10" Padding="14,10" Margin="12,12,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1A1040" Offset="0"/>
                                <GradientStop Color="#0D1B2A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="Properties" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                    </Border>

                    <!-- Tab Buttons -->
                    <UniformGrid Grid.Row="1" Columns="4" Margin="12,8,12,0">
                        <Button Content="🔊" FontSize="16" Padding="0,8" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#94A3B8"
                                Command="{Binding SelectPropertiesTabCommand}" CommandParameter="0" ToolTip="Audio"/>
                        <Button Content="🎨" FontSize="16" Padding="0,8" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#94A3B8"
                                Command="{Binding SelectPropertiesTabCommand}" CommandParameter="1" ToolTip="Colors"/>
                        <Button Content="✏️" FontSize="16" Padding="0,8" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#94A3B8"
                                Command="{Binding SelectPropertiesTabCommand}" CommandParameter="2" ToolTip="Text"/>
                        <Button Content="✨" FontSize="16" Padding="0,8" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#94A3B8"
                                Command="{Binding SelectPropertiesTabCommand}" CommandParameter="3" ToolTip="Effects"/>
                    </UniformGrid>

                    <!-- Tab Content -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <Grid Margin="14,8,14,14">

                            <!-- ═══ TAB 0: AUDIO ═══ -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPropertiesTab}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Speed Card -->
                                <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Border Background="#F59E0B" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="16,12">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Speed" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Value="{Binding Speed}" Minimum="0.1" Maximum="16" TickFrequency="0.1" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Speed, StringFormat='{}{0:F1}x'}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Volume Card -->
                                <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Border Background="#3B82F6" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="16,12">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="🔊" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Volume" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Value="{Binding Volume}" Minimum="0" Maximum="200" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Volume, StringFormat='{}{0:F0}%'}" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Speed & Playback Card -->
                                <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Border Background="#F59E0B" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="16,12">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="⏱️" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Speed &amp; Playback" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="35"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Speed" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Value="{Binding Speed}" Minimum="0.1" Maximum="4.0" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Speed, StringFormat='{}{0:F1}x'}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            
                                            <CheckBox Content="Ters Oynat (Reverse)" IsChecked="{Binding IsReversed}" Foreground="#E2E8F0" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Advanced Audio Card -->
                                <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Border Background="#A855F7" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="16,12">
                                            <TextBlock Text="🎚️ Advanced" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Pitch" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Value="{Binding Pitch}" Minimum="-12" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="EQ" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" SelectedItem="{Binding AudioEqualizerPreset}" Style="{StaticResource ModernComboBox}">
                                                    <ComboBoxItem Content="Normal"/>
                                                    <ComboBoxItem Content="Bass Boost"/>
                                                    <ComboBoxItem Content="Vocal"/>
                                                    <ComboBoxItem Content="Podcast"/>
                                                </ComboBox>
                                            </Grid>
                                            <CheckBox IsChecked="{Binding IsNoiseReductionEnabled}" Content="AI Noise Reduction" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Fade Card -->
                                <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Border Background="#10B981" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="16,12">
                                            <TextBlock Text="📉 Fade" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="In" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Value="{Binding FadeInDuration}" Minimum="0" Maximum="5" TickFrequency="0.1" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FadeInDuration, StringFormat='{}{0:F1}s'}" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Out" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Value="{Binding FadeOutDuration}" Minimum="0" Maximum="5" TickFrequency="0.1" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FadeOutDuration, StringFormat='{}{0:F1}s'}" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ═══ TAB 1: COLORS ═══ -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPropertiesTab}" Value="1">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Color Adjust Card -->
                                <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Border Background="#F59E0B" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="16,12">
                                            <TextBlock Text="🎨 Color Adjust" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Exposure" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Value="{Binding Exposure}" Minimum="-100" Maximum="100" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Contrast" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Value="{Binding Contrast}" Minimum="-100" Maximum="100" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Saturation" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Value="{Binding Saturation}" Minimum="-100" Maximum="100" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Temp" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Value="{Binding Temperature}" Minimum="-100" Maximum="100" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Filters Grid -->
                                <TextBlock Text="Filtreler" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="4,4,0,8"/>
                                <UniformGrid Columns="3" Margin="0,0,0,4">
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,4,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="retro" MouseLeftButtonDown="FilterCard_MouseLeftButtonDown">
                                        <TextBlock Text="Retro" Foreground="#EAB308" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,4,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="35mm" MouseLeftButtonDown="FilterCard_MouseLeftButtonDown">
                                        <TextBlock Text="35mm" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,0,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="grayscale" MouseLeftButtonDown="FilterCard_MouseLeftButtonDown">
                                        <TextBlock Text="B&amp;W" Foreground="#F8FAFC" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,4,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="warm" MouseLeftButtonDown="FilterCard_MouseLeftButtonDown">
                                        <TextBlock Text="Warm" Foreground="#F59E0B" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,4,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="winter" MouseLeftButtonDown="FilterCard_MouseLeftButtonDown">
                                        <TextBlock Text="Winter" Foreground="#3B82F6" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,0,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="cinema" MouseLeftButtonDown="FilterCard_MouseLeftButtonDown">
                                        <TextBlock Text="Cinema" Foreground="#8B5CF6" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>

                            <!-- ═══ TAB 2: TEXT ═══ -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPropertiesTab}" Value="2">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Content Card -->
                                <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Border Background="#F43F5E" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="16,12">
                                            <TextBlock Text="Metin İçeriği" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                                            <TextBox Text="{Binding SelectedTextOverlay.Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" FontSize="12" ToolTip="Videonun üzerinde görünecek metni girin"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Font Card -->
                                <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Border Background="#EC4899" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="16,12">
                                            <TextBlock Text="T Font" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                                            <ComboBox SelectedItem="{Binding SelectedTextOverlay.FontFamily}" Style="{StaticResource ModernComboBox}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="Inter"/>
                                                <ComboBoxItem Content="Roboto"/>
                                                <ComboBoxItem Content="Open Sans"/>
                                                <ComboBoxItem Content="Montserrat"/>
                                                <ComboBoxItem Content="Bebas Neue"/>
                                            </ComboBox>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Size" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding SelectedTextOverlay.FontSize}" Style="{StaticResource ModernTextBox}" Padding="8,6" FontSize="12"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Position & Animation Card -->
                                <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Border Background="#3B82F6" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="16,12">
                                            <TextBlock Text="Konum &amp; Animasyon" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="X Ekseni" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Value="{Binding SelectedTextOverlay.PositionX}" Minimum="0" Maximum="1" TickFrequency="0.01"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Y Ekseni" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Value="{Binding SelectedTextOverlay.PositionY}" Minimum="0" Maximum="1" TickFrequency="0.01"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Efekt" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedTextOverlay.Animation}" Style="{StaticResource ModernComboBox}">
                                                    <ComboBoxItem Content="none"/>
                                                    <ComboBoxItem Content="fade"/>
                                                    <ComboBoxItem Content="slide-in"/>
                                                    <ComboBoxItem Content="typewriter"/>
                                                    <ComboBoxItem Content="bounce"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Style Card -->
                                <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Border Background="#8B5CF6" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="16,12">
                                            <TextBlock Text="Stil" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Outline" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Value="{Binding SelectedTextOverlay.OutlineThickness}" Minimum="0" Maximum="10"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Shadow" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Value="{Binding SelectedTextOverlay.ShadowOpacity}" Minimum="0" Maximum="1" TickFrequency="0.1"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Opacity" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Value="{Binding SelectedTextOverlay.Transparency}" Minimum="0" Maximum="100"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Subtitles & Import -->
                                <TextBlock Text="Subtitles" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="4,4,0,8"/>
                                <Button Content="📥 Import SRT File" Command="{Binding ImportSrtCommand}" 
                                        Style="{StaticResource SecondaryButton}" Padding="10,8" Margin="0,0,0,8" FontSize="11"
                                        Foreground="#60A5FA" ToolTip="Dışarıdan .srt altyazı dosyası yükler"/>

                                <!-- Delete Selected Text -->
                                <Button Content="🗑️ Seçili Metni Sil" Command="{Binding DeleteTextOverlayCommand}" 
                                        Style="{StaticResource SecondaryButton}" Padding="10,8" Margin="0,4,0,0" FontSize="11"
                                        Foreground="#EF4444" ToolTip="Seçili metin katmanını kaldırır"/>
                            </StackPanel>

                            <!-- ═══ TAB 3: EFFECTS ═══ -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPropertiesTab}" Value="3">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Transitions Card -->
                                <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Border Background="#6366F1" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                        <StackPanel Margin="16,12">
                                            <TextBlock Text="✨ Transitions" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Yön" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" SelectedItem="{Binding TransitionDirection}" Style="{StaticResource ModernComboBox}">
                                                    <ComboBoxItem Content="Left to Right"/>
                                                    <ComboBoxItem Content="Right to Left"/>
                                                    <ComboBoxItem Content="Top to Bottom"/>
                                                    <ComboBoxItem Content="Bottom to Top"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Süre" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Value="{Binding TransitionDuration}" Minimum="0.1" Maximum="3.0" TickFrequency="0.1" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TransitionDuration, StringFormat='{}{0:F1}s'}" Foreground="#6366F1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Effects Grid -->
                                <TextBlock Text="Efektler" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="4,4,0,8"/>
                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,4,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="blur" MouseLeftButtonDown="EffectCard_MouseLeftButtonDown">
                                        <TextBlock Text="Blur" Foreground="#3B82F6" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,4,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="vhs" MouseLeftButtonDown="EffectCard_MouseLeftButtonDown">
                                        <TextBlock Text="VHS" Foreground="#EF4444" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,0,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="glitch" MouseLeftButtonDown="EffectCard_MouseLeftButtonDown">
                                        <TextBlock Text="Glitch" Foreground="#10B981" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,4,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="spin" MouseLeftButtonDown="EffectCard_MouseLeftButtonDown">
                                        <TextBlock Text="Spin" Foreground="#EAB308" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,4,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="pulse" MouseLeftButtonDown="EffectCard_MouseLeftButtonDown">
                                        <TextBlock Text="Pulse" Foreground="#EC4899" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,0,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="flash" MouseLeftButtonDown="EffectCard_MouseLeftButtonDown">
                                        <TextBlock Text="Flash" Foreground="#F8FAFC" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,4,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="sharpen" MouseLeftButtonDown="EffectCard_MouseLeftButtonDown">
                                        <TextBlock Text="Sharpen" Foreground="#22D3EE" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,4,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="denoise" MouseLeftButtonDown="EffectCard_MouseLeftButtonDown">
                                        <TextBlock Text="Denoise" Foreground="#A3E635" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,0,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="chromatic" MouseLeftButtonDown="EffectCard_MouseLeftButtonDown">
                                        <TextBlock Text="Chromatic" Foreground="#FB923C" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,4,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="vaporwave" MouseLeftButtonDown="EffectCard_MouseLeftButtonDown">
                                        <TextBlock Text="Vaporwave" Foreground="#C084FC" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#0D1117" CornerRadius="8" Margin="0,0,4,4" Padding="0,10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" Tag="smoke" MouseLeftButtonDown="EffectCard_MouseLeftButtonDown">
                                        <TextBlock Text="Smoke" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                </UniformGrid>

                                <Button Content="↺ Tümünü Sıfırla" Command="{Binding ResetEffectsCommand}" Style="{StaticResource SecondaryButton}" Padding="12,8"/>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ DIVIDER ═══ -->
        <Border Grid.Row="2" Height="1" Background="#1E293B"/>

        <!-- ═══ BOTTOM: Status Bar + Timeline Stub ═══ -->
        <Border Grid.Row="3" Background="#0D1117">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Timeline Toolbar -->
                <Border Grid.Row="0" Background="#10141C" Padding="12,6" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="✂️" Command="{Binding SplitSceneCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,4,0" ToolTip="Split (S)"/>
                            <Button Content="🗑️" Command="{Binding DeleteSceneCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,4,0" ToolTip="Delete"/>
                            <Button Content="⧉" Command="{Binding DuplicateSceneCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,8,0" ToolTip="Duplicate"/>
                            <Border Width="1" Background="#1E293B" Margin="0,2,8,2"/>
                            <Button Content="🔇 Sesi Ayır" Command="{Binding DetachAudioCommand}" Style="{StaticResource SecondaryButton}" Padding="5,4" Margin="0,0,4,0" ToolTip="Mutes or detaches the global master audio track"/>
                            <Button Content="🎙️ Seslendir" Command="{Binding RecordVoiceoverCommand}" Style="{StaticResource SecondaryButton}" Padding="5,4" Margin="0,0,8,0" ToolTip="Record microphone audio for a Voiceover track"/>
                            <Border Width="1" Background="#1E293B" Margin="0,2,8,2"/>
                            <Button Content="↺" Command="{Binding UndoCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,4,0" ToolTip="Undo (Ctrl+Z)"/>
                            <Button Content="↻" Command="{Binding RedoCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,4,0" ToolTip="Redo (Ctrl+Y)"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CurrentPlaybackTimeDisplay}" Foreground="#A855F7" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#F8FAFC" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="🔍" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider Width="100" Minimum="0.25" Maximum="4.0" Value="{Binding ZoomScale}" TickFrequency="0.25" IsSnapToTickEnabled="True" VerticalAlignment="Center" Foreground="#3B82F6"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Timeline Area -->
                <Border Grid.Row="1" Background="#080B11">
                    <Grid>
                        <!-- Empty State -->
                        <TextBlock Text="Timeline — Import media to begin editing" FontSize="13" Foreground="#334155"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasVideo, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                        
                        <!-- Tracks Context -->
                        <Grid Visibility="{Binding HasVideo, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/> <!-- Time Ruler -->
                                <RowDefinition Height="*"/> <!-- Tracks Area -->
                            </Grid.RowDefinitions>
                            
                            <!-- Time Ruler (Dynamic) -->
                            <Border Grid.Row="0" Background="#10141C" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                <Canvas x:Name="TimeRulerCanvas" 
                                        MouseLeftButtonDown="TimeRulerCanvas_MouseLeftButtonDown"
                                        MouseMove="TimeRulerCanvas_MouseMove"
                                        MouseLeftButtonUp="TimeRulerCanvas_MouseLeftButtonUp"
                                        Background="Transparent" Cursor="Hand"/>
                            </Border>

                            <ScrollViewer x:Name="TimelineScrollViewer" Grid.Row="1" 
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          ScrollChanged="TimelineScrollViewer_ScrollChanged">
                                <Grid Background="Transparent" MouseLeftButtonDown="TracksGrid_MouseLeftButtonDown">
                                    <StackPanel VerticalAlignment="Top" Margin="16,8">
                                        
                                        <!-- Video/Scene Track -->
                                        <TextBlock Text="🎬 Scenes" Foreground="#3B82F6" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <Border Background="#141E293B" BorderBrush="#1E293B" BorderThickness="0,1" MinHeight="48" Margin="0,0,0,8">
                                            <ItemsControl ItemsSource="{Binding Scenes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Height="44" Margin="1,2" Padding="6,0" Cursor="Hand"
                                                                MouseLeftButtonDown="SceneBlock_MouseLeftButtonDown"
                                                                AllowDrop="True"
                                                                MouseMove="SceneBlock_MouseMove"
                                                                DragEnter="SceneBlock_DragEnter"
                                                                Drop="SceneBlock_Drop">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource DurationAndZoomMulti}">
                                                                    <Binding Path="Duration"/>
                                                                    <Binding Path="DataContext.ZoomScale" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                </MultiBinding>
                                                            </Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#1A3B82F6"/>
                                                                    <Setter Property="BorderBrush" Value="#333B82F6"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="#2A3B82F6"/>
                                                                            <Setter Property="BorderBrush" Value="#A855F7"/>
                                                                            <Setter Property="BorderThickness" Value="2"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <!-- Left Trim Handle -->
                                                                <Border Width="5" HorizontalAlignment="Left" Background="#4A3B82F6" CornerRadius="4,0,0,4" Cursor="SizeWE"
                                                                        Tag="Left"
                                                                        MouseLeftButtonDown="TrimHandle_MouseLeftButtonDown"
                                                                        MouseMove="TrimHandle_MouseMove"
                                                                        MouseLeftButtonUp="TrimHandle_MouseLeftButtonUp">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#A855F7"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                                <!-- Scene Info (Center) -->
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding SceneNumber, StringFormat='S{0}'}" Foreground="#60A5FA" FontSize="10" FontWeight="Bold" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="{Binding Duration, StringFormat='{}{0:F1}s'}" Foreground="#94A3B8" FontSize="9"/>
                                                                </StackPanel>
                                                                <!-- Right Trim Handle -->
                                                                <Border Width="5" HorizontalAlignment="Right" Background="#4A3B82F6" CornerRadius="0,4,4,0" Cursor="SizeWE"
                                                                        Tag="Right"
                                                                        MouseLeftButtonDown="TrimHandle_MouseLeftButtonDown"
                                                                        MouseMove="TrimHandle_MouseMove"
                                                                        MouseLeftButtonUp="TrimHandle_MouseLeftButtonUp">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#A855F7"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <!-- Audio Track -->
                                        <TextBlock Text="🎵 Audio" Foreground="#10B981" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <Border Background="#141E293B" BorderBrush="#1E293B" BorderThickness="0,1" Height="32" Margin="0,0,0,8" Padding="0"
                                                AllowDrop="True" Drop="AudioTrack_Drop">
                                            <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="4" Height="24" HorizontalAlignment="Left" Padding="8,0" MinWidth="60">
                                                <TextBlock Text="{Binding AudioFilePath, FallbackValue='Drag audio here'}" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                            </Border>
                                        </Border>
                                    </StackPanel>

                                    <!-- Playhead overlay (Dynamic) -->
                                    <Canvas IsHitTestVisible="True" Margin="16,0,0,0">
                                        <Path Data="M-5,-5 L10,-5 L10,0 L2,10 L-5,10 Z" Fill="#A855F7" Canvas.Left="{Binding PlayheadPixelPosition}" Canvas.Top="-5"
                                              Cursor="SizeWE" MouseLeftButtonDown="Playhead_MouseLeftButtonDown" MouseMove="Playhead_MouseMove" MouseLeftButtonUp="Playhead_MouseLeftButtonUp"/>
                                        <Border Width="12" Height="300" Canvas.Top="5" Background="Transparent" Canvas.Left="{Binding PlayheadPixelPosition}" Margin="-5,0,0,0"
                                                Cursor="SizeWE" MouseLeftButtonDown="Playhead_MouseLeftButtonDown" MouseMove="Playhead_MouseMove" MouseLeftButtonUp="Playhead_MouseLeftButtonUp">
                                            <Border Width="2" HorizontalAlignment="Center" Background="#A855F7" />
                                        </Border>
                                    </Canvas>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
