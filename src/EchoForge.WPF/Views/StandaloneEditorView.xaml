                                    </Border>
                                </UniformGrid>
                            </StackPanel>

                            <!-- Transitions Tab -->
                            <StackPanel Visibility="{Binding AssetLibraryMode, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter='Transitions'}">
