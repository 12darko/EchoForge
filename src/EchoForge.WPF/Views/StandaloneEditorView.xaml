                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,4" Padding="8" MinHeight="45" Cursor="Hand" Tag="quote" MouseLeftButtonDown="TextStyleCard_MouseLeftButtonDown">
