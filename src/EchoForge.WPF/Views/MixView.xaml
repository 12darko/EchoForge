<UserControl x:Class="EchoForge.WPF.Views.MixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EchoForge.WPF.Localization"
             xmlns:vm="clr-namespace:EchoForge.WPF.ViewModels"
             Background="#0B0E14" Foreground="#F8FAFC">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#12161F" BorderBrush="#1A1F2B" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎧" FontSize="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Mix Studio" FontSize="16" FontWeight="Bold" Foreground="#8B5CF6"/>
                    <TextBlock Text=" — Render edilmiş şarkılardan mix oluştur" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="🔄 Yenile" Command="{Binding LoadAvailableTracksCommand}"
                        Style="{StaticResource SecondaryButton}" Padding="14,6" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Row="1" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ──── LEFT: Available Tracks ──── -->
            <Border Grid.Column="0" Background="#12161F" CornerRadius="12" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="🎵 Kullanılabilir Parçalar" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                        <TextBlock Text="Render edilmiş projeleriniz burada listelenir." FontSize="11" Foreground="#64748B"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding AvailableTracks}" SelectedItem="{Binding SelectedAvailableTrack}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="#0D1117" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Margin="0,3" Padding="12,10" Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1A2234"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2A1B54"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#8B5CF6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" ClipToBounds="True" Background="#1E293B">
                                        <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding DurationDisplay}" FontSize="11" Foreground="#8B5CF6" FontWeight="SemiBold"/>
                                            <TextBlock Text=" • " FontSize="11" Foreground="#475569"/>
                                            <TextBlock Text="{Binding FileSize}" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Add Button -->
                                    <Button Grid.Column="2" Content="➕" FontSize="16" 
                                            Command="{Binding DataContext.AddToMixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center" Cursor="Hand" Padding="8,4"
                                            Background="Transparent" Foreground="#10B981" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1A10B981"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ──── RIGHT: Mix Queue ──── -->
            <Border Grid.Column="2" Background="#12161F" CornerRadius="12" Padding="16">
                <DockPanel>
                    <!-- Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="🎶 Mix Sırası" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Toplam: " FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding TotalMixDurationDisplay}" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                                    <TextBlock Text=" • " FontSize="12" Foreground="#475569"/>
                                    <TextBlock Text="{Binding MixQueue.Count, StringFormat='{}{0} parça'}" FontSize="12" Foreground="#8B5CF6" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="🧹" ToolTip="Temizle" Command="{Binding ClearMixCommand}" 
                                        Width="32" Height="32" FontSize="14" Background="Transparent" Foreground="#EF4444" 
                                        BorderThickness="0" Cursor="Hand" Padding="0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Bottom: Mix Controls -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">

                        <!-- Mix Settings -->
                        <Border Background="#0D1117" CornerRadius="10" Padding="14,12" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚙️ Mix Ayarları" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,10"/>

                                <!-- Target Duration -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Hedef Süre:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Width="100"/>
                                    <TextBox Text="{Binding TargetDurationMinutes, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBox}" Width="60" TextAlignment="Center"/>
                                    <TextBlock Text="dk" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>

                                <!-- Crossfade Duration -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Crossfade:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Width="100"/>
                                    <Slider Value="{Binding CrossfadeDuration}" Minimum="0" Maximum="10" SmallChange="0.5" Width="120" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CrossfadeDuration, StringFormat='{}{0:F1}s'}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>

                                <!-- Custom Background Image -->
                                <TextBlock Text="Arkaplan Görseli (İsteğe Bağlı):" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox Grid.Column="0" Text="{Binding CustomBackgroundImagePath}" IsReadOnly="True" 
                                             Style="{StaticResource ModernTextBox}" FontSize="11" Margin="0,0,6,0" Foreground="#64748B" ToolTip="{Binding CustomBackgroundImagePath}"/>
                                    
                                    <Button Grid.Column="1" Content="📁 Seç" Command="{Binding SelectBackgroundImageCommand}" 
                                            Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                                            
                                    <Button Grid.Column="2" Content="✕" Command="{Binding ClearBackgroundImageCommand}" 
                                            Background="Transparent" BorderThickness="0" Foreground="#EF4444" Cursor="Hand" Padding="4"
                                            Visibility="{Binding CustomBackgroundImagePath, Converter={StaticResource StringToVisibility}}"/>
                                </Grid>
                                <TextBlock Text="Sonsuz döngü (örn. lo-fi arka planı). Seçilmezse videolar ardışık oynatılır." FontSize="10" Foreground="#475569" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding AutoMixCommand}" Padding="12,12" FontWeight="Bold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Background" Value="#F59E0B"/>
                                        <Setter Property="Foreground" Value="#0B0E14"/>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎲" Margin="0,0,6,0"/>
                                    <TextBlock Text="Otomatik Mix"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Command="{Binding RenderMixCommand}" Padding="12,12" FontWeight="Bold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#10B981" Offset="0"/>
                                                    <GradientStop Color="#059669" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎬" Margin="0,0,6,0"/>
                                    <TextBlock Text="Mix Render"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Output Path -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" 
                                    Visibility="{Binding OutputMixPath, Converter={StaticResource StringToVisibility}}">
                            <TextBlock Text="📁" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding OutputMixPath}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Content="Aç" Command="{Binding OpenMixFileCommand}" 
                                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="8,4" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Queue List -->
                    <ListBox ItemsSource="{Binding MixQueue}" SelectedItem="{Binding SelectedQueueTrack}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="#0D1117" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Margin="0,3" Padding="10,8" Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1A2234"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1A10B981"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Track Number -->
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="♪" FontSize="14" Foreground="#8B5CF6" VerticalAlignment="Center"/>

                                    <!-- Thumbnail with overlay buttons -->
                                    <Grid Grid.Column="1" Grid.Row="0">
                                        <Border Width="38" Height="38" CornerRadius="6" ClipToBounds="True" Background="#1E293B">
                                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                                        </Border>
                                        <!-- Overlay: Change Image Button (visible on hover via parent) -->
                                        <Border Width="38" Height="38" CornerRadius="6" Background="#99000000" x:Name="ImageOverlay" Opacity="0" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="🖼" FontSize="12" Padding="2" Width="18" Height="18"
                                                        Command="{Binding DataContext.ChangeTrackImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="#10B981" BorderThickness="0" Cursor="Hand" ToolTip="Görsel Değiştir"/>
                                                <Button Content="✕" FontSize="10" Padding="2" Width="18" Height="18"
                                                        Command="{Binding DataContext.ClearTrackImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" ToolTip="Görseli Sıfırla"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DurationDisplay}" FontSize="10" Foreground="#8B5CF6"/>
                                    </StackPanel>

                                    <!-- Move Buttons -->
                                    <StackPanel Grid.Column="3" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                        <Button Content="▲" FontSize="10" Width="24" Height="24" Padding="0"
                                                Command="{Binding DataContext.MoveTrackUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="▼" FontSize="10" Width="24" Height="24" Padding="0"
                                                Command="{Binding DataContext.MoveTrackDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>

                                    <!-- Remove Button -->
                                    <Button Grid.Column="4" Grid.Row="0" Content="✕" FontSize="11" Width="24" Height="24" Padding="0"
                                            Command="{Binding DataContext.RemoveFromMixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand"/>

                                    <!-- Per-Track Effect Selector (Row 2) -->
                                    <StackPanel Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="VFX:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox ItemsSource="{x:Static vm:MixTrackItem.EffectOptions}" 
                                                  SelectedItem="{Binding SelectedEffect}" 
                                                  Style="{StaticResource ModernComboBox}" 
                                                  Width="100" FontSize="10" Height="24" Padding="4,2"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="2" Background="#12161F" BorderBrush="#1A1F2B" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <!-- Loading -->
                <TextBlock Text="⏳ Yükleniyor..." FontSize="12" Foreground="#A855F7" FontStyle="Italic"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                
                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#10B981" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}"/>

                <!-- Render Progress -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsMixRendering, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="🎬 Rendering..." FontSize="12" Foreground="#F59E0B" FontStyle="Italic"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
