<UserControl x:Class="EchoForge.WPF.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:converters="clr-namespace:EchoForge.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1200"
             xmlns:loc="clr-namespace:EchoForge.WPF.Localization"
             Background="#0B0E14" Foreground="#F8FAFC">

    <UserControl.Resources>
        <converters:DurationAndZoomMultiConverter x:Key="DurationAndZoomMultiConverter"/>
        <converters:StringMatchToVisibilityConverter x:Key="StringMatchVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Audio player handled by NAudio in code-behind -->

        <!-- ═══════════════ HEADER BAR ═══════════════ -->
        <Border Grid.Row="0" Background="#12161F" BorderBrush="#1A1F2B" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="20,0">
                <Button DockPanel.Dock="Left" Content="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_BackToDashboard]}" Style="{StaticResource SecondaryButton}" 
                        Command="{Binding GoBackCommand}" Padding="12,6" VerticalAlignment="Center" Margin="0,0,20,0"/>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_VideoEditor]}" FontSize="16" FontWeight="Bold" Margin="0,0,12,0" Foreground="{StaticResource AccentPurpleBrush}"/>
                    <TextBlock Text="{Binding ProjectTitle, StringFormat='— {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Export/Render Button moved to header for better visibility -->
                <Button DockPanel.Dock="Right" Content="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_RenderFinalVideo]}" 
                        Command="{Binding RenderVideoCommand}"
                        Padding="16,8" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#10B981" Offset="0"/>
                                        <GradientStop Color="#059669" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>
        </Border>

        <!-- ═══════════════ MAIN CONTENT ═══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/> <!-- Primary Nav Ribbon -->
                <ColumnDefinition Width="Auto" MaxWidth="300" /> <!-- Expanding Asset Library -->
                <ColumnDefinition Width="*" MinWidth="200"/> <!-- Center Preview/Canvas -->
                <ColumnDefinition Width="360"/> <!-- Contextual Properties Panel -->
            </Grid.ColumnDefinitions>

            <!-- ──── EXTREME LEFT: PRIMARY NAV RIBBON ──── -->
            <Border Grid.Column="0" Background="#080A0F" BorderBrush="#1A1F2B" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,16,0,0">
                    <!-- Media -->
                    <Button ToolTip="Your Media" Background="Transparent" BorderThickness="0" Padding="0,12" Cursor="Hand" Margin="0,0,0,8"
                            Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="Media">
                        <StackPanel>
                            <TextBlock Text="📁" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Media" FontSize="10" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssetLibraryMode}" Value="Media">
                                                <Setter Property="Foreground" Value="#60A5FA"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    
                    <!-- Record -->
                    <Button ToolTip="Record" Background="Transparent" BorderThickness="0" Padding="0,12" Cursor="Hand" Margin="0,0,0,8"
                            Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="Record">
                        <StackPanel>
                            <TextBlock Text="🔴" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Record" FontSize="10" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssetLibraryMode}" Value="Record">
                                                <Setter Property="Foreground" Value="#60A5FA"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Library -->
                    <Button ToolTip="Content Library" Background="Transparent" BorderThickness="0" Padding="0,12" Cursor="Hand" Margin="0,0,0,8"
                            Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="Library">
                        <StackPanel>
                            <TextBlock Text="📚" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Library" FontSize="10" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssetLibraryMode}" Value="Library">
                                                <Setter Property="Foreground" Value="#60A5FA"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Music -->
                    <Button ToolTip="Music" Background="Transparent" BorderThickness="0" Padding="0,12" Cursor="Hand" Margin="0,0,0,8"
                            Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="Music">
                        <StackPanel>
                            <TextBlock Text="🎵" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Music" FontSize="10" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssetLibraryMode}" Value="Music">
                                                <Setter Property="Foreground" Value="#60A5FA"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Text -->
                    <Button ToolTip="Text" Background="Transparent" BorderThickness="0" Padding="0,12" Cursor="Hand" Margin="0,0,0,8"
                            Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="Text">
                        <StackPanel>
                            <TextBlock Text="T" FontWeight="Bold" FontSize="20" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Text" FontSize="10" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssetLibraryMode}" Value="Text">
                                                <Setter Property="Foreground" Value="#60A5FA"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Transitions -->
                    <Button ToolTip="Transitions" Background="Transparent" BorderThickness="0" Padding="0,12" Cursor="Hand" Margin="0,0,0,8"
                            Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="Transitions">
                        <StackPanel>
                            <TextBlock Text="✨" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Transitions" FontSize="10" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssetLibraryMode}" Value="Transitions">
                                                <Setter Property="Foreground" Value="#60A5FA"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ──── LEFT: EXTENDED ASSET LIBRARY ──── -->
            <Border Grid.Column="1" Background="#0C1017" BorderBrush="#1A1F2B" BorderThickness="0,0,1,0" Width="300"
                    Visibility="{Binding IsAssetLibraryOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding AssetLibraryMode}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Button Content="✕" Command="{Binding ToggleAssetLibraryCommand}" CommandParameter="{Binding AssetLibraryMode}" 
                                DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}" Padding="6,4" ToolTip="Close Panel"/>
                    </DockPanel>

                    <!-- Dynamic content switches based on AssetLibraryMode -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Media Tab -->
                            <StackPanel Visibility="{Binding AssetLibraryMode, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter='Media'}">
                                <TextBlock Text="Imported media will appear here." Foreground="#94A3B8" Padding="0,0,0,16" TextWrapping="Wrap"/>
                                <Button Content="➕ Import Media" Style="{StaticResource PrimaryButton}" Padding="12,10" Margin="0,0,0,12"/>
                                <Border BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="8" Padding="16" Background="#0A3B82F6">
                                    <TextBlock Text="Drag and drop files here" Foreground="#94A3B8" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Record Tab -->
                            <StackPanel Visibility="{Binding AssetLibraryMode, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter='Record'}">
                                <TextBlock Text="Create a new recording directly." Foreground="#94A3B8" Padding="0,0,0,16" TextWrapping="Wrap"/>
                                <Button Content="📹 Screen &amp; Camera" Style="{StaticResource PrimaryButton}" Padding="12,10" Margin="0,0,0,8" Background="#EAB308" Foreground="#1F2937"/>
                                <Button Content="📸 Camera Only" Style="{StaticResource SecondaryButton}" Padding="12,10" Margin="0,0,0,8"/>
                                <Button Content="🎤 Audio Only" Style="{StaticResource SecondaryButton}" Padding="12,10" Margin="0,0,0,8"/>
                            </StackPanel>

                            <!-- Library Tab -->
                            <StackPanel Visibility="{Binding AssetLibraryMode, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter='Library'}">
                                <TextBlock Text="Browse stock images and videos." Foreground="#94A3B8" Padding="0,0,0,16" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" ToolTip="Search library..."/>
                                <Border Background="#1A3B82F6" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <TextBlock Text="EchoForge content library coming soon." Foreground="#3B82F6" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Music Tab -->
                            <StackPanel Visibility="{Binding AssetLibraryMode, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter='Music'}">
                                <TextBlock Text="Add background music and sound effects." Foreground="#94A3B8" Padding="0,0,0,16" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" ToolTip="Search music..."/>
                                <Button Content="🎵 Browse Royalty Free" Style="{StaticResource PrimaryButton}" Padding="12,10" Margin="0,0,0,12"/>
                            </StackPanel>

                            <!-- Text Tab -->
                            <StackPanel Visibility="{Binding AssetLibraryMode, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter='Text'}">
                                <TextBlock Text="Add text over your video." Foreground="#94A3B8" Padding="0,0,0,16" TextWrapping="Wrap"/>
                                <Button Content="T Add Plain Text" Style="{StaticResource SecondaryButton}" Padding="12,10" Margin="0,0,0,16" Foreground="#F8FAFC" FontWeight="Bold"/>
                                <TextBlock Text="Styles" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2">
                                    <!-- Stubs for Text Styles -->
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,8,8" Padding="8" MinHeight="60">
                                        <TextBlock Text="Header" Foreground="#F8FAFC" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,8" Padding="8" MinHeight="60">
                                        <TextBlock Text="Subtitle" Foreground="#94A3B8" TextAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,8,0" Padding="8" MinHeight="60">
                                        <TextBlock Text="Neon" Foreground="#EC4899" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Padding="8" MinHeight="60">
                                        <TextBlock Text="Glitch" Foreground="#10B981" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>

                            <!-- Transitions Tab -->
                            <StackPanel Visibility="{Binding AssetLibraryMode, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter='Transitions'}">
                                <TextBlock Text="Add transitions between scenes." Foreground="#94A3B8" Padding="0,0,0,16" TextWrapping="Wrap"/>
                                <TextBlock Text="Note: Drag a transition between clips." Foreground="#EAB308" FontSize="11" Margin="0,0,0,16"/>
                                <UniformGrid Columns="2">
                                    <!-- Stubs for Transitions -->
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,8,8" Padding="8" MinHeight="60">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="↔️" FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Crossfade" Foreground="#F8FAFC" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,0,8" Padding="8" MinHeight="60">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="⬛" FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Fade to Black" Foreground="#F8FAFC" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#1A1E293B" CornerRadius="8" Margin="0,0,8,0" Padding="8" MinHeight="60">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="🔜" FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Push" Foreground="#F8FAFC" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ──── CENTER: PREVIEW AREA & PLAYBACK ──── -->
            <Grid Grid.Column="2" Margin="8,8,4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0D1117" CornerRadius="12" ClipToBounds="True">
                    <Grid Background="Transparent" dd:DragDrop.IsDropTarget="True" dd:DragDrop.DropHandler="{Binding}">
                        <!-- Scene Preview Image (Always shows the image at playhead) -->
                        <Border Background="#161B22" CornerRadius="12">
                            <Grid>
                                <!-- No selection placeholder -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding PreviewImagePath, Converter={StaticResource StringToInverseVisibility}}">
                                    <TextBlock Text="🎬" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_VideoPreview]}" Foreground="#4A5568" FontSize="16" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <!-- The Image & Effects Preview Overlays -->
                                <Grid Margin="16" Opacity="{Binding PreviewOpacity, FallbackValue=1.0}">
                                    
                                    <Image Source="{Binding PreviewImagePath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedScene.Filter}" Value="blur">
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <BlurEffect Radius="20" KernelType="Gaussian"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedScene.Filter}" Value="grayscale">
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <BlurEffect Radius="0" KernelType="Gaussian"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Opacity" Value="0.999"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    
                                    <!-- OVERLAYS FOR FILTERS -->
                                    <Rectangle Stretch="Fill" IsHitTestVisible="False">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <!-- Warm Filter (Orange tint) -->
                                                    <DataTrigger Binding="{Binding ActiveScene.Filter}" Value="warm">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Fill" Value="#22FF8C00"/>
                                                    </DataTrigger>
                                                    <!-- Cool Filter (Blue tint) -->
                                                    <DataTrigger Binding="{Binding ActiveScene.Filter}" Value="cool">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Fill" Value="#2200A2FF"/>
                                                    </DataTrigger>
                                                    <!-- Sepia Filter -->
                                                    <DataTrigger Binding="{Binding ActiveScene.Filter}" Value="sepia">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Fill" Value="#33704214"/>
                                                    </DataTrigger>
                                                    <!-- Vintage Filter -->
                                                    <DataTrigger Binding="{Binding ActiveScene.Filter}" Value="vintage">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Fill" Value="#44211105"/>
                                                    </DataTrigger>
                                                    <!-- High Contrast Filter (Simulated with black transparent) -->
                                                    <DataTrigger Binding="{Binding ActiveScene.Filter}" Value="highcontrast">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Fill" Value="#11000000"/>
                                                    </DataTrigger>
                                                    <!-- Grayscale Filter (Gray overlay to desaturate) -->
                                                    <DataTrigger Binding="{Binding ActiveScene.Filter}" Value="grayscale">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Fill" Value="#88808080"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>

                                    <!-- Vignette Overlay -->
                                    <Border IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveScene.Filter}" Value="vignette">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Background>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#00000000" Offset="0.6"/>
                                                <GradientStop Color="#BF000000" Offset="1.1"/>
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Active Scene info overlay -->
                        <Border Background="#E60B0E14" CornerRadius="0,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Top" 
                                Padding="14,8"
                                Visibility="{Binding ActiveScene, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ActiveScene.SceneNumber, StringFormat='Scene {0}'}" FontSize="14" FontWeight="Bold" Foreground="#A855F7"/>
                                <TextBlock Text=" • " FontSize="14" Foreground="#4A5568"/>
                                <TextBlock Text="{Binding ActiveScene.Transition, FallbackValue='none'}" FontSize="14" Foreground="#10B981" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>

                        <!-- Total playback time overlay -->
                        <Border Background="#E60B0E14" CornerRadius="0,0,0,10" HorizontalAlignment="Right" VerticalAlignment="Top" 
                                Padding="14,8">
                            <TextBlock Text="{Binding CurrentPlaybackTimeDisplay, FallbackValue='0:00 / 0:00'}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- PLAYBACK CONTROLS -->
                <Border Grid.Row="1" Background="#12161F" CornerRadius="8" Margin="0,8,0,0" Padding="12,8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Undo -->
                            <Button Content="↩️" Command="{Binding UndoCommand}" ToolTip="Undo" Style="{StaticResource SecondaryButton}" Width="40" Height="40" FontSize="18" Margin="0,0,16,0" Padding="0"/>
                            
                            <!-- Jump to Start -->
                            <Button Content="⏮" Command="{Binding SeekToStartCommand}" Style="{StaticResource SecondaryButton}" Width="40" Height="40" FontSize="16" Margin="0,0,8,0" Padding="0"/>
                            <!-- Play/Pause -->
                            <Button Command="{Binding TogglePlaybackCommand}" Width="50" Height="50" FontSize="20" Margin="0,0,8,0" Padding="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="▶"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Content" Value="⏸"/>
                                                <Setter Property="Background" Value="#F59E0B"/> <!-- Orange when playing -->
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Jump to End -->
                            <Button Content="⏭" Command="{Binding SeekToEndCommand}" Style="{StaticResource SecondaryButton}" Width="40" Height="40" FontSize="16" Margin="0,0,16,0" Padding="0"/>
                            
                            <!-- Redo -->
                            <Button Content="↪️" Command="{Binding RedoCommand}" ToolTip="Redo" Style="{StaticResource SecondaryButton}" Width="40" Height="40" FontSize="18" Padding="0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ──── RIGHT: PROPERTIES PANEL ──── -->
            <Border Grid.Column="3" Background="#12161F" Margin="4,8,8,8" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <!-- Show Project Settings when NO scene selected -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedScene, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                        <StackPanel Margin="20,16">
                            
                            <!-- Project Settings Header -->
                            <Border CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1A1040" Offset="0"/>
                                        <GradientStop Color="#0D1B2A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_ProjectSettings]}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_GlobalSettings]}" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                            </Border>

                            <!-- 🔊 Audio Volume Card -->
                            <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,12" BorderBrush="#1E293B" BorderThickness="1">
                                <Grid>
                                    <!-- Accent bar -->
                                    <Border Background="#3B82F6" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                    <StackPanel Margin="16,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="🔊" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_MusicVolume]}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="VolumeSlider" Value="{Binding AudioVolume}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AudioVolume, StringFormat='{}{0:P0}'}" FontSize="12" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 🎬 Video Intro Fade Card -->
                            <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,12" BorderBrush="#1E293B" BorderThickness="1">
                                <Grid>
                                    <Border Background="#10B981" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                    <StackPanel Margin="16,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="🌅" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_VideoIntroFade]}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_IntroFadeDesc]}" FontSize="10" Foreground="#64748B" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Value="{Binding ProjectFadeIn}" Minimum="0" Maximum="5" SmallChange="0.1" TickFrequency="0.5" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProjectFadeIn, StringFormat='{}{0:F1}s'}" FontSize="12" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 🌙 Video Outro Fade Card -->
                            <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,12" BorderBrush="#1E293B" BorderThickness="1">
                                <Grid>
                                    <Border Background="#F59E0B" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                    <StackPanel Margin="16,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="🌙" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_VideoOutroFade]}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_OutroFadeDesc]}" FontSize="10" Foreground="#64748B" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Value="{Binding ProjectFadeOut}" Minimum="0" Maximum="5" SmallChange="0.1" TickFrequency="0.5" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProjectFadeOut, StringFormat='{}{0:F1}s'}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_SelectSceneHint]}" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ═══════ SCENE PROPERTIES (shown when a scene IS selected) ═══════ -->
                    <DockPanel Visibility="{Binding SelectedScene, Converter={StaticResource NullToVisibilityConverter}}">

                        <!-- Scene Number Header (pinned at top) -->
                        <Border DockPanel.Dock="Top" CornerRadius="10" Padding="14,10" Margin="16,16,16,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#2D1B69" Offset="0"/>
                                        <GradientStop Color="#1A1040" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎬" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding SelectedScene.SceneNumber, StringFormat='Scene {0}'}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                                </StackPanel>
                        </Border>

                        <!-- Restore Save Button, Loading, and Status at bottom of Scene Properties -->
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" FontSize="13" Foreground="#10B981" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,4,0,12"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}"/>
                                   
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_Processing]}" FontSize="13" Foreground="#A855F7" FontStyle="Italic"/>
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" Margin="16,8,16,12">
                            <Button Content="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_SaveAllChanges]}" 
                                    Style="{StaticResource PrimaryButton}" 
                                    Command="{Binding ApplySceneEditsCommand}"
                                    Padding="12,10" HorizontalAlignment="Stretch"/>
                        </Border>

                        <!-- TabControl fills remaining space, headers always visible -->
                        <TabControl Background="Transparent" BorderThickness="0" Margin="0,8,0,0">
                                <TabControl.Resources>
                                    <Style TargetType="TabItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TabItem">
                                                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Border" Property="BorderBrush" Value="#8B5CF6"/>
                                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#E2E8F0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TabControl.Resources>

                                <!-- TAB 1: Sahne & Görsel -->
                                <TabItem Header="🖼 Sahne">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16,12,16,0">
                                        <!-- Duration -->
                                        <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_Duration]}" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding SelectedScene.Duration, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}" 
                                     Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedSceneDurationDisplay}" FontSize="11" Foreground="#4A5568" Margin="0,0,0,16"/>

                            <!-- Image Prompt -->
                            <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_ImagePrompt]}" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding SelectedScene.Prompt, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" Height="90" 
                                     TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"/>

                            <!-- Image Dimensions (AI Generation resolution) -->
                            <TextBlock Text="Görsel Boyutu (Genişlik x Yükseklik)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBox Text="{Binding DataContext.ProjectWidth, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=1920}" Style="{StaticResource ModernTextBox}" Width="70" TextAlignment="Center" ToolTip="Genişlik (Piksel)"/>
                                <TextBlock Text="x" Foreground="#64748B" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
                                <TextBox Text="{Binding DataContext.ProjectHeight, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=1080}" Style="{StaticResource ModernTextBox}" Width="70" TextAlignment="Center" ToolTip="Yükseklik (Piksel)"/>
                            </StackPanel>

                            <!-- AI Model Selection for Regeneration -->
                            <TextBlock Text="Yapay Zeka Modeli" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding DataContext.EditorRegenerateImageModels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding DataContext.SelectedEditorImageModel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      Style="{StaticResource ModernComboBox}" Margin="0,0,0,12" ToolTip="Yeniden oluşturma için kullanılacak AI modeli"/>

                            <!-- Regenerate Scene Image -->
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding RegenerateSceneCommand}"
                                    Padding="10,12" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                                    BorderBrush="#8B5CF6" BorderThickness="1" Background="#1A0D1117">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✨" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_RegenerateImage]}" FontWeight="SemiBold" Foreground="#A855F7"/>
                                </StackPanel>
                            </Button>

                            <!-- ═══ Replace Scene Image Section ═══ -->
                            <Border Background="#0D1117" CornerRadius="10" Margin="0,4,0,12" BorderBrush="#1E293B" BorderThickness="1">
                                <Grid>
                                    <Border Background="#F59E0B" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                    <StackPanel Margin="16,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="🖼️" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="Görseli Değiştir" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Load from Computer -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Button x:Name="BtnReplaceFromFile" Style="{StaticResource SecondaryButton}" 
                                                    Command="{Binding ReplaceSceneImageFromFileCommand}"
                                                    Padding="10,10" HorizontalAlignment="Stretch"
                                                    BorderBrush="#F59E0B" BorderThickness="1" Background="#1A1A0D00" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📁" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Bilgisayardan Yükle" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" 
                                                    Command="{Binding RemoveSceneImageCommand}"
                                                    ToolTip="Bu sahneden özel görseli sil"
                                                    Padding="12,10" BorderBrush="#EF4444" BorderThickness="1" Background="#1A4A0000" Cursor="Hand">
                                                <TextBlock Text="🗑️" FontSize="14" Foreground="#EF4444"/>
                                            </Button>
                                        </Grid>
                                        
                                        <!-- Load from URL -->
                                        <TextBlock Text="veya URL'den indir:" FontSize="11" Foreground="#64748B" Margin="0,4,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding ImageUrlInput, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     FontSize="11" Margin="0,0,6,0"
                                                     ToolTip="Görsel URL'si yapıştırın"/>
                                            <Button Grid.Column="1" Content="🌐 İndir"
                                                    Command="{Binding ReplaceSceneImageFromUrlCommand}"
                                                    Padding="10,8" FontWeight="SemiBold" FontSize="11" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                        <Setter Property="Background" Value="#3B82F6"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                                    </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- TAB 2: Geçişler -->
                                <TabItem Header="✨ Geçişler">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="16,12,16,0">
                                            <Border CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#1A1040" Offset="0"/>
                                                        <GradientStop Color="#0F172A" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel>
                                                    <TextBlock Text="Geçiş Efektleri" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Sahneler arası geçişi yumuşatmak için bir efekt seçin." FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </Border>
                                            <ListBox SelectedValue="{Binding SelectedScene.Transition}" SelectedValuePath="Tag" 
                                                     Background="Transparent" BorderThickness="0" Margin="0,0,0,16" 
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="3" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="Bd" Background="#0D1117" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Margin="3" Padding="0" Cursor="Hand" Height="72">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#1A2234"/>
                                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#2A1B54"/>
                                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8B5CF6"/>
                                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <!-- Transition Items -->
                                                <ListBoxItem Tag="none">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,4">
                                                            <TextBlock Text="🚫" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="Yok" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </ListBoxItem>
                                                <ListBoxItem Tag="fade">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="#1A3B82F6" HorizontalAlignment="Center" Margin="0,0,0,4">
                                                            <TextBlock Text="🌫️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="Fade" FontSize="10" Foreground="#3B82F6" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </ListBoxItem>
                                                <ListBoxItem Tag="smoothleft">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="#1A10B981" HorizontalAlignment="Center" Margin="0,0,0,4">
                                                            <TextBlock Text="⬅️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="Sol" FontSize="10" Foreground="#10B981" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </ListBoxItem>
                                                <ListBoxItem Tag="smoothright">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="#1A10B981" HorizontalAlignment="Center" Margin="0,0,0,4">
                                                            <TextBlock Text="➡️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="Sağ" FontSize="10" Foreground="#10B981" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </ListBoxItem>
                                                <ListBoxItem Tag="zoompan">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="#1AF59E0B" HorizontalAlignment="Center" Margin="0,0,0,4">
                                                            <TextBlock Text="🔍" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="Yakınlaş" FontSize="10" Foreground="#F59E0B" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </ListBoxItem>
                                                <ListBoxItem Tag="spin">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="#1AF59E0B" HorizontalAlignment="Center" Margin="0,0,0,4">
                                                            <TextBlock Text="🌀" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="Döndür" FontSize="10" Foreground="#F59E0B" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </ListBoxItem>
                                                <ListBoxItem Tag="glitch">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="#1AEF4444" HorizontalAlignment="Center" Margin="0,0,0,4">
                                                            <TextBlock Text="📺" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="Glitch" FontSize="10" Foreground="#EF4444" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </ListBoxItem>
                                                <ListBoxItem Tag="pixelize">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="#1A06B6D4" HorizontalAlignment="Center" Margin="0,0,0,4">
                                                            <TextBlock Text="👾" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="Pixel" FontSize="10" Foreground="#06B6D4" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </ListBoxItem>
                                                <ListBoxItem Tag="wipe">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="#1A10B981" HorizontalAlignment="Center" Margin="0,0,0,4">
                                                            <TextBlock Text="🧹" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="Wipe" FontSize="10" Foreground="#10B981" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </ListBoxItem>
                                            </ListBox>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- TAB 3: Görsel Efektler (Visual Effects) -->
                                <TabItem Header="🎭 Efektler">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="16,12,16,0">
                                            <Border CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#1A1040" Offset="0"/>
                                                        <GradientStop Color="#0F172A" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel>
                                                    <TextBlock Text="Görsel Efektler" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Sahnenize sanatsal ve sinematik efektler ekleyin." FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Blur Effect Card -->
                                            <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,8" BorderBrush="#1E293B" BorderThickness="1">
                                                <Grid>
                                                    <Border Background="#3B82F6" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                                    <StackPanel Margin="16,12">
                                                        <CheckBox Content="Odağı Bulanıklaştır (Blur)" IsChecked="{Binding SelectedScene.Filter, Converter={StaticResource EqualityConverter}, ConverterParameter=blur}" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,8" BorderBrush="#1E293B" BorderThickness="1">
                                                <Grid>
                                                    <Border Background="#EF4444" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                                    <StackPanel Margin="16,12">
                                                        <CheckBox Content="Sarsıntı Etkisi (Shake)" IsChecked="False" Foreground="#E2E8F0" FontWeight="SemiBold" ToolTip="Gelecek güncellemede aktif olacak."/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Green Screen placeholder -->
                                            <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,8" BorderBrush="#1E293B" BorderThickness="1">
                                                <Grid>
                                                    <Border Background="#10B981" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                                    <StackPanel Margin="16,12">
                                                        <CheckBox Content="Yeşil Ekran (Chroma Key)" IsChecked="False" Foreground="#E2E8F0" FontWeight="SemiBold" ToolTip="Gelecek güncellemede aktif olacak."/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- TAB 4: Renk Filters (Color) -->
                                <TabItem Header="🎨 Renk">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="16,12,16,0">
                                            <Border CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#1A1040" Offset="0"/>
                                                        <GradientStop Color="#0F172A" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel>
                                                    <TextBlock Text="Renk Filtreleri" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Görüntünün renk tonunu ve atmosferini değiştirin." FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </Border>

                                            <ComboBox SelectedValue="{Binding SelectedScene.Filter}" SelectedValuePath="Tag" Style="{StaticResource ModernComboBox}" Height="36">
                                                <ComboBoxItem Content="Orijinal Renkler (Yok)" Tag="none"/>
                                                <ComboBoxItem Content="Retro (Vintage)" Tag="vintage"/>
                                                <ComboBoxItem Content="Siyah Beyaz (Grayscale)" Tag="grayscale"/>
                                                <ComboBoxItem Content="Nostaljik (Sepia)" Tag="sepia"/>
                                                <ComboBoxItem Content="Sıcak Tonlar" Tag="warm"/>
                                                <ComboBoxItem Content="Soğuk Tonlar" Tag="cool"/>
                                                <ComboBoxItem Content="Yüksek Kontrast" Tag="highcontrast"/>
                                                <ComboBoxItem Content="Vignette (Kenar Karartma)" Tag="vignette"/>
                                            </ComboBox>

                                            <!-- Intensity Slider Placeholder -->
                                            <TextBlock Text="Filtre Yoğunluğu" Foreground="#94A3B8" FontSize="12" Margin="0,16,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="45"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="100%" FontSize="12" FontWeight="Bold" Foreground="#06B6D4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- TAB 5: Ayarlar (Speed & Audio) -->
                                <TabItem Header="⚡ Ayarlar">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="16,12,16,0">
                                            
                                            <!-- Speed Card -->
                                            <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                                                <Grid>
                                                    <Border Background="#F59E0B" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                                    <StackPanel Margin="16,12">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Oynatma Hızı" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="45"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Slider Value="{Binding SelectedScene.Speed}" Minimum="0.25" Maximum="4.0" SmallChange="0.25" IsSnapToTickEnabled="True" TickFrequency="0.25" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding SelectedScene.Speed, StringFormat='{}{0:F2}x'}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Fade In Card -->
                                            <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                                                <Grid>
                                                    <Border Background="#8B5CF6" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                                    <StackPanel Margin="16,12">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                            <TextBlock Text="🌅" FontSize="14" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Sahnede Karararak Açıl (Fade In)" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="45"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Slider Value="{Binding SelectedScene.FadeInDuration}" Minimum="0" Maximum="5" SmallChange="0.1" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding SelectedScene.FadeInDuration, StringFormat='{}{0:F1}s'}" FontSize="12" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Fade Out Card -->
                                            <Border Background="#0D1117" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                                                <Grid>
                                                    <Border Background="#EC4899" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10"/>
                                                    <StackPanel Margin="16,12">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                            <TextBlock Text="🌙" FontSize="14" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Sahnede Karararak Kapan (Fade Out)" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="45"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Slider Value="{Binding SelectedScene.FadeOutDuration}" Minimum="0" Maximum="5" SmallChange="0.1" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding SelectedScene.FadeOutDuration, StringFormat='{}{0:F1}s'}" FontSize="12" FontWeight="Bold" Foreground="#EC4899" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- TAB 3: Yayınla & Onay -->
                                <TabItem Header="🚀 Yayınla">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16,12,16,0">
                                        <!-- Publish Header -->
                                        <Border CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#1A1040" Offset="0"/>
                                                    <GradientStop Color="#0F172A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel>
                                                <TextBlock Text="Yayınlama ve Onay" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                                                <TextBlock Text="Videonuzu onaylayarak YouTube API üzerinden planlanan zamana gönderebilirsiniz." FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Scheduling Options Card -->
                                        <Border Background="#1A1E293B" BorderBrush="#331E293B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="⏳ İleri Tarihe Zamanla (İsteğe Bağlı)" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                                <TextBlock Text="Eğer videonun hemen değil, ileride bir saatte yayınlanmasını istiyorsanız tarihi ayarlayın. (Zamanlanmış videolar 'Gizli' olarak yüklenir.)" 
                                                           FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <DatePicker SelectedDate="{Binding ScheduledPublishDate, UpdateSourceTrigger=PropertyChanged}" 
                                                                Grid.Column="0" Height="28" Foreground="Black" Background="White" ToolTip="Tarih seçin"/>
                                                                
                                                    <TextBox Text="{Binding ScheduledPublishTime, UpdateSourceTrigger=PropertyChanged}" 
                                                             Grid.Column="2" Style="{StaticResource ModernTextBox}" 
                                                             ToolTip="Saat formatı: 18:00 vb." TextAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Approve Video Card -->
                                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="✅ Onay Bekliyor (Awaiting Approval)" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,8"/>
                                                <TextBlock Text="Bu proje tamamlandıysa onaylayarak yayın akışına alabilirsiniz." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                                <Button Content="Projeyi Onayla" Command="{Binding ApproveProjectCommand}" 
                                                        Padding="12,10" FontWeight="Bold" Foreground="#0B0E14" Margin="0,0,0,8" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                            <Setter Property="Background" Value="#10B981"/>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="YouTube'a Yükle" Command="{Binding UploadToYouTubeCommand}" 
                                                        Padding="12,10" FontWeight="Bold" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                            <Setter Property="Background" Value="#EF4444"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Video Output Card -->
                                        <Border Background="#1A3B82F6" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="🎬 Oluşturulan Video" FontSize="14" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding OutputVideoPath}" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,8"
                                                           Visibility="{Binding OutputVideoPath, Converter={StaticResource StringToVisibility}}"/>
                                                <Button Content="📂 Videoyu Aç" Command="{Binding OpenVideoFileCommand}" 
                                                        Padding="12,10" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,4"
                                                        Visibility="{Binding OutputVideoPath, Converter={StaticResource StringToVisibility}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                            <Setter Property="Background" Value="#3B82F6"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="📁 Klasörü Aç" Command="{Binding OpenVideoFolderCommand}" 
                                                        Padding="12,8" Cursor="Hand"
                                                        Visibility="{Binding OutputVideoPath, Converter={StaticResource StringToVisibility}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- YouTube Link Card -->
                                        <Border Background="#1AEF4444" BorderBrush="#33EF4444" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12"
                                                Visibility="{Binding YouTubeVideoUrl, Converter={StaticResource StringToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Text="▶️ YouTube'da Yayında" FontSize="14" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding YouTubeVideoUrl}" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                <Button Content="🔗 YouTube'da Aç" Command="{Binding OpenYouTubeLinkCommand}" 
                                                        Padding="12,10" FontWeight="Bold" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                            <Setter Property="Background" Value="#EF4444"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                        </TabControl>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════ TIMELINE TOOLBAR ═══════════════ -->
        <Border Grid.Row="2" Background="#12161F" Margin="16,0,16,0" Padding="8,6" CornerRadius="8,8,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Undo / Redo -->
                    <Button Content="↺" Command="{Binding UndoCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,4,0" ToolTip="Undo" FontSize="14" Foreground="#94A3B8"/>
                    <Button Content="↻" Command="{Binding RedoCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,8,0" ToolTip="Redo" FontSize="14" Foreground="#94A3B8"/>
                    <Border Width="1" Background="#2A2F3A" Margin="0,2,8,2"/>

                    <!-- Edit Tools -->
                    <Button Content="✂️" Command="{Binding SplitSceneCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="8,4" ToolTip="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_Split]}" FontSize="14"/>
                    <Button Content="🗑️" Command="{Binding DeleteSceneCommand}" Style="{StaticResource SecondaryButton}" Foreground="#F43F5E" Padding="8,4" Margin="0,0,4,0" ToolTip="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_Delete]}" FontSize="14"/>
                    <Button Content="⧉" Command="{Binding DuplicateSceneCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,8,0" ToolTip="Duplicate" FontSize="14" Foreground="#60A5FA"/>
                    <Border Width="1" Background="#2A2F3A" Margin="0,2,8,2"/>

                    <!-- Trim Tools -->
                    <Button Content="[ In" Command="{Binding MarkInCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,4,0" ToolTip="Mark In point at current playhead position" Foreground="#3B82F6"/>
                    <Button Content="Out ]" Command="{Binding MarkOutCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,4,0" ToolTip="Mark Out point at current playhead position" Foreground="#3B82F6"/>
                    <Button Content="✂️ Trim Range" Command="{Binding TrimToRangeCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,4,0" ToolTip="Trim video to the selected In/Out range" Foreground="#F59E0B"
                            Visibility="{Binding HasRange, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="✕" Command="{Binding ClearRangeCommand}" Style="{StaticResource SecondaryButton}" Padding="6,4" Margin="0,0,4,0" ToolTip="Clear range selection" FontSize="10"
                            Visibility="{Binding HasRange, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding RangeDisplay}" FontSize="10" Foreground="#3B82F6" VerticalAlignment="Center" Margin="4,0,0,0" FontStyle="Italic"/>
                </StackPanel>
                
                <!-- Zoom Slider (Right side) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,4,0">
                    <!-- Timeline Tutorial Tip -->
                    <Border Background="#1A3B82F6" CornerRadius="6" Padding="8,4" Margin="0,0,12,0" Cursor="Help"
                            ToolTip="Timeline Tips:&#x0a;• Click a scene to select and edit it&#x0a;• Drag the right edge of a scene to resize&#x0a;• Use Split to cut a scene at the playhead&#x0a;• Set In/Out points then Trim to crop&#x0a;• Drag scenes to reorder them&#x0a;• Use the zoom slider to see more detail">
                        <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_Tips]}" FontSize="10" Foreground="#3B82F6" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="-" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="14" FontWeight="Bold"/>
                    <Slider Value="{Binding ZoomScale}" Minimum="0.3" Maximum="3.0" Width="120" VerticalAlignment="Center"
                            TickFrequency="0.1" IsSnapToTickEnabled="False" SmallChange="0.1" LargeChange="0.5"
                            ToolTip="Timeline Zoom"/>
                    <TextBlock Text="+" Foreground="#4A5568" VerticalAlignment="Center" Margin="4,0,8,0" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ZoomScale, StringFormat='{}{0:F1}x'}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Width="30"/>
                </StackPanel>

                <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_DragHint]}" Foreground="#4A5568" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="#0D1117" BorderBrush="#1A1F2B" BorderThickness="0,1,0,0" Height="28" Margin="0,0,0,0">
            <DockPanel Margin="16,0">
                <!-- Fixed label area -->
                <Border DockPanel.Dock="Left" Width="60">
                    <TextBlock Text="⏱ Time" FontSize="10" Foreground="#4A5568" VerticalAlignment="Center"/>
                </Border>
                <!-- Canvas for ticks AND playhead -->
                <Grid>
                    <Canvas x:Name="TimeRulerCanvas" Background="Transparent" ClipToBounds="True" 
                            MouseLeftButtonDown="TimeRulerCanvas_MouseLeftButtonDown"
                            MouseMove="TimeRulerCanvas_MouseMove"
                            MouseLeftButtonUp="TimeRulerCanvas_MouseLeftButtonUp"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ═══════════════ TIMELINE TRACK ═══════════════ -->
        <Border Grid.Row="4" Background="#12161F" BorderBrush="#1A1F2B" BorderThickness="0,1,0,0" MinHeight="140" MaxHeight="200">
            <DockPanel Margin="16,10">
                <!-- Fixed left label -->
                <StackPanel DockPanel.Dock="Left" Width="60" Margin="0,0,0,0">
                    <TextBlock Text="🎞️" FontSize="16" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_VideoTrack]}" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Source={x:Static loc:TranslationManager.Instance}, Path=Strings[Ed_Track]}" FontSize="10" Foreground="#4A5568"/>
                </StackPanel>
                <!-- Scrollable Timeline Track with Playhead Overlay -->
                <Grid>
                    <ScrollViewer x:Name="TimelineScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  ScrollChanged="TimelineScrollViewer_ScrollChanged">
                        <Grid x:Name="TrackGrid" 
                              MouseLeftButtonDown="TrackGrid_MouseLeftButtonDown" 
                              MouseMove="TrackGrid_MouseMove"
                              MouseLeftButtonUp="TrackGrid_MouseLeftButtonUp"
                              Background="Transparent" MinWidth="{Binding ActualWidth, ElementName=TimelineScrollViewer}">
                            <!-- Track background lines -->
                            <Border Background="#08FFFFFF" CornerRadius="6" Height="110" VerticalAlignment="Top"/>

                            <!-- Scene blocks -->
                            <ItemsControl ItemsSource="{Binding Scenes}" Height="110" VerticalAlignment="Top"
                                          dd:DragDrop.IsDropTarget="True"
                                          dd:DragDrop.DropHandler="{Binding}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Scene Block Wrapper -->
                                            <Border Grid.Column="0" MinWidth="12"
                                                    CornerRadius="6"
                                                    BorderBrush="#5A6FFF" BorderThickness="1.5"
                                                    Margin="2,4,0,4">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#2A1B4D" Offset="0"/>
                                                        <GradientStop Color="#1A1230" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource DurationAndZoomMultiConverter}">
                                                        <Binding Path="Duration"/>
                                                        <Binding Path="DataContext.ZoomScale" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                                
                                                <!-- Selected outline trigger -->
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                <Setter Property="BorderBrush" Value="#60A5FA"/>
                                                                <Setter Property="Background" Value="#335A6FFF"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#335A6FFF"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <!-- 
                                                   CORE FIX: GongSolutions DragSource is strictly isolated to the Inner Grid 
                                                   so it doesn't accidentally steal MouseDown events belonging to the resize handles.
                                                -->
                                                <Grid x:Name="SceneInnerGrid" Cursor="Hand"
                                                      dd:DragDrop.IsDragSource="True"
                                                      dd:DragDrop.DragDropContext="TimelineScene"
                                                      AllowDrop="True" Drop="Scene_Drop">
                                                    
                                                    <Grid.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.SelectSceneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Grid.InputBindings>

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Top bar of scene block (Scene number, Duration, Badges) -->
                                                    <Border Grid.Row="0" Background="#4D5A6FFF" Padding="4,2" CornerRadius="4,4,0,0">
                                                        <StackPanel Orientation="Horizontal" ClipToBounds="True">
                                                            <TextBlock Text="{Binding SceneNumber, StringFormat='Scene {0}'}" FontSize="10" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding DurationStr}" FontSize="9" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                            
                                                            <!-- Filter/Effect Badge -->
                                                            <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="4" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Background" Value="#333B82F6"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Filter}" Value="none">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Filter}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Filter}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Filter}" Value="blur">
                                                                                <Setter Property="Background" Value="#553B82F6"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Filter}" Value="sepia">
                                                                                <Setter Property="Background" Value="#55D97706"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Filter}" Value="vintage">
                                                                                <Setter Property="Background" Value="#558B5CF6"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Filter}" Value="cool">
                                                                                <Setter Property="Background" Value="#550EA5E9"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Filter}" Value="warm">
                                                                                <Setter Property="Background" Value="#55F97316"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Filter}" Value="grayscale">
                                                                                <Setter Property="Background" Value="#55888888"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Filter}" Value="highcontrast">
                                                                                <Setter Property="Background" Value="#55FFFFFF"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Filter}" Value="vignette">
                                                                                <Setter Property="Background" Value="#55333333"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Filter}" FontSize="9" Foreground="#F8FAFC" FontWeight="SemiBold"/>
                                                            </Border>

                                                            <!-- FadeIn Badge -->
                                                            <Border Margin="4,0,0,0" Padding="3,1" CornerRadius="4" Background="#3310B981" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasFadeIn}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="⬆ IN" FontSize="8" Foreground="#10B981" FontWeight="Bold"/>
                                                            </Border>

                                                            <!-- FadeOut Badge -->
                                                            <Border Margin="4,0,0,0" Padding="3,1" CornerRadius="4" Background="#33EC4899" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasFadeOut}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="⬇ OUT" FontSize="8" Foreground="#EC4899" FontWeight="Bold"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Main content of scene block (Thumbnail, info, effect overlays) -->
                                                    <Grid Grid.Row="1" ClipToBounds="True">
                                                        <!-- Base content -->
                                                        <Border Padding="4,4" CornerRadius="0,0,4,4">
                                                            <Grid>
                                                                <Grid MinWidth="20" MinHeight="40" Background="#1AFFFFFF">
                                                                    <TextBlock Text="🖼️" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Opacity="0.5">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill" Opacity="0.6" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Prompt}" FontSize="9" Foreground="#CBD5E1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="54,0,0,0" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Effect color accent stripe (left edge) -->
                                                        <Border Width="4" HorizontalAlignment="Left" CornerRadius="0,0,0,4">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Filter}" Value="blur">
                                                                            <Setter Property="Background" Value="#3B82F6"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Filter}" Value="sepia">
                                                                            <Setter Property="Background" Value="#D97706"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Filter}" Value="vintage">
                                                                            <Setter Property="Background" Value="#8B5CF6"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Filter}" Value="cool">
                                                                            <Setter Property="Background" Value="#0EA5E9"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Filter}" Value="warm">
                                                                            <Setter Property="Background" Value="#F97316"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Filter}" Value="grayscale">
                                                                            <Setter Property="Background" Value="#888888"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Filter}" Value="highcontrast">
                                                                            <Setter Property="Background" Value="#FFFFFF"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Filter}" Value="vignette">
                                                                            <Setter Property="Background" Value="#333333"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>

                                                        <!-- FadeIn gradient overlay (green, left edge) -->
                                                        <Border Width="30" HorizontalAlignment="Left" Opacity="0.7">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasFadeIn}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#6610B981" Offset="0"/>
                                                                    <GradientStop Color="#0010B981" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <!-- FadeOut gradient overlay (pink, right edge) -->
                                                        <Border Width="30" HorizontalAlignment="Right" Opacity="0.7">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasFadeOut}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                                                    <GradientStop Color="#66EC4899" Offset="0"/>
                                                                    <GradientStop Color="#00EC4899" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <!-- Right resize handle -->
                                            <Border Grid.Column="1" Width="8" Background="#1AFFFFFF" Cursor="SizeWE"
                                                    Tag="{Binding}" Margin="-4,4,0,4"
                                                    ToolTip="Resmi Kırp / Uzat"
                                                    MouseLeftButtonDown="SceneRightEdge_MouseLeftButtonDown"
                                                    MouseMove="SceneRightEdge_MouseMove"
                                                    MouseLeftButtonUp="SceneRightEdge_MouseLeftButtonUp">
                                                <!-- Visual Handle Grid -->
                                                <Border Width="4" HorizontalAlignment="Center" VerticalAlignment="Center" Height="20" Background="#66FFFFFF" CornerRadius="2"/>
                                            </Border>

                                            <!-- Transition indicator arrow between scenes -->
                                            <Border Grid.Column="2" Width="28" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Glowing Arrow -->
                                                    <TextBlock Text="▶▶" FontSize="12" HorizontalAlignment="Center" ToolTip="Geçiş (Transition)">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#10B981"/> <!-- Green when active -->
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Transition}" Value="none">
                                                                        <Setter Property="Foreground" Value="#334A5568"/>
                                                                        <Setter Property="Text" Value="▶"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Transition}" Value="{x:Null}">
                                                                        <Setter Property="Foreground" Value="#334A5568"/>
                                                                        <Setter Property="Text" Value="▶"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Transition}" Value="">
                                                                        <Setter Property="Foreground" Value="#334A5568"/>
                                                                        <Setter Property="Text" Value="▶"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    
                                                    <!-- Transition Name Text -->
                                                    <TextBlock Text="{Binding Transition}" FontSize="8" Foreground="#10B981" 
                                                               HorizontalAlignment="Center" FontStyle="Italic" TextTrimming="CharacterEllipsis" MaxWidth="28" Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Transition}" Value="none">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Transition}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Transition}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- PLAYHEAD OVERLAY (Vertical Red Line confined to Video Track) -->
                    <Canvas IsHitTestVisible="False">
                        <!-- Playhead group translated via ViewModel binding -->
                        <Canvas x:Name="PlayheadGroup" Canvas.Left="{Binding PlayheadPixelPosition}">
                            <Path Data="M -5,0 L 5,0 L 5,10 L 0,15 L -5,10 Z" Fill="#ED0B3E"/>
                            <Line X1="0" Y1="15" X2="0" Y2="140" Stroke="#ED0B3E" StrokeThickness="1.5" Opacity="0.8"/>
                        </Canvas>
                    </Canvas>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ═══════════════ AUDIO TRACK (Multi-track) ═══════════════ -->
        <Border Grid.Row="5" Background="#12161F" BorderBrush="#1A1F2B" BorderThickness="0,1,0,0" Height="50">
            <DockPanel Margin="16,4">
                <StackPanel DockPanel.Dock="Left" Width="60" Margin="0,0,0,0">
                    <TextBlock Text="🎵" FontSize="16" Margin="0,4,0,2"/>
                    <TextBlock Text="Audio" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    <TextBlock Text="BGM" FontSize="10" Foreground="#4A5568"/>
                </StackPanel>
                
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" 
                              x:Name="AudioScrollViewer">
                    <Grid x:Name="AudioTrackGrid" Background="Transparent" MinWidth="{Binding ActualWidth, ElementName=AudioScrollViewer}">
                        
                        <!-- Track background line -->
                        <Border Background="#08FFFFFF" CornerRadius="6" Height="36" VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="2000" x:Name="AudioTrackBackground"/>
                        
                        <!-- The Audio Clip Wrapper (With Trim Handle) -->
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- The Audio Clip Inner Block -->
                            <Border x:Name="AudioClipBlock" Grid.Column="0" Background="#1A10B981" CornerRadius="4" Height="30"
                                    BorderBrush="#4D10B981" BorderThickness="1.5" Cursor="Hand" ToolTip="Arka Plan Müziği"
                                    AllowDrop="True" Drop="AudioTrack_Drop" DragEnter="AudioTrack_DragEnter">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource DurationAndZoomMultiConverter}">
                                        <Binding Path="AudioDuration" />
                                        <Binding Path="ZoomScale" />
                                    </MultiBinding>
                                </Border.Width>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3310B981"/>
                                                <Setter Property="BorderBrush" Value="#8010B981"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <!-- Simulated Waveform Background -->
                                    <Path Fill="#3310B981" Stretch="Fill" Data="M 0,15 L 5,5 L 10,12 L 15,3 L 20,18 L 25,6 L 30,14 L 35,5 L 40,11 L 45,2 L 50,16 L 55,7 L 60,13 L 65,4 L 70,17 L 75,8 L 80,15 L 85,6 L 90,12 L 95,3 L 100,15 Z" Opacity="0.5" VerticalAlignment="Bottom" Height="20" HorizontalAlignment="Left" Width="100"/>
                                    
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" ClipToBounds="True">
                                        <TextBlock Text="🎵 BGM" FontSize="10" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AudioDuration, StringFormat='{} ({0:F1}s)'}" FontSize="9" Foreground="#6EE7B7" Margin="8,0,0,0" VerticalAlignment="Center" FontStyle="Italic"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Audio Right Resize Handle -->
                            <Border Grid.Column="1" Width="8" Background="#1AFFFFFF" Cursor="SizeWE" Margin="-4,0,0,0"
                                    ToolTip="Sesi Kırp / Uzat"
                                    MouseLeftButtonDown="AudioRightEdge_MouseLeftButtonDown"
                                    MouseLeftButtonUp="AudioRightEdge_MouseLeftButtonUp"
                                    MouseMove="AudioRightEdge_MouseMove">
                                <Border Width="4" HorizontalAlignment="Center" VerticalAlignment="Center" Height="20" Background="#66FFFFFF" CornerRadius="2"/>
                            </Border>
                        </Grid>
                        
                        <!-- Empty spacer so we can scroll past end -->
                        <Border Width="100" HorizontalAlignment="Right"/>

                        <!-- PLAYHEAD OVERLAY FOR AUDIO TRACK -->
                        <Canvas IsHitTestVisible="False">
                            <Canvas Canvas.Left="{Binding PlayheadPixelPosition}">
                                <Line X1="0" Y1="0" X2="0" Y2="50" Stroke="#ED0B3E" StrokeThickness="1.5" Opacity="0.8"/>
                            </Canvas>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
